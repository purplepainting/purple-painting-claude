@inject CurrentUser Me
@{
    var title = ViewData["Title"] as string;
    var moduleName = ViewData["ModuleName"] as string ?? title ?? "Dashboard";
}
<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
    <meta name="theme-color" content="#2E1248">
    @* Phone home-screen install (iPhone and Android). The manifest needs credentials because Easy Auth guards every path. *@
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
    <meta name="apple-mobile-web-app-title" content="Purple">
    <link rel="apple-touch-icon" href="~/icons/apple-touch-icon.png">
    <link rel="manifest" href="~/manifest.webmanifest" crossorigin="use-credentials">
    <title>@(title is null ? "" : title + " · ")Purple Painting Dashboard</title>
    <link rel="icon" type="image/png" sizes="32x32" href="~/icons/favicon-32.png">
    <link rel="icon" type="image/png" sizes="64x64" href="~/icons/favicon-64.png">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true">
    @await RenderSectionAsync("Head", required: false)
</head>
<body>
    @* The checkbox opens the menu on phones without needing JavaScript. *@
    <input type="checkbox" id="nav-toggle" class="nav-toggle" aria-hidden="true" tabindex="-1">
    <div class="shell">
        <aside class="sidebar" id="sidebar">
            <a class="brand" href="/"><img class="logo" src="~/icons/logo-96.png" alt="" width="34" height="34"><span>Purple Painting</span></a>
            @await Component.InvokeAsync("SideNav")
            @if (Me.DisplayName is not null)
            {
                var path = Context.Request.Path.Value ?? "";
                var inSettings = path.StartsWith("/settings", StringComparison.OrdinalIgnoreCase) || path.StartsWith("/connections", StringComparison.OrdinalIgnoreCase) || path.StartsWith("/changes", StringComparison.OrdinalIgnoreCase);
                <div class="sidebar-user" title="@Me.Email">
                    <span class="sidebar-user-name">@Me.DisplayName</span>
                    <a class="settings-button@(inSettings ? " active" : "")" href="/settings" aria-current="@(inSettings ? "page" : null)"><partial name="_Icon" model="@("settings")" /><span>Settings</span></a>
                </div>
            }
        </aside>
        <label for="nav-toggle" class="scrim" aria-hidden="true"></label>

        <div class="main">
            <header class="topbar">
                <div class="topbar-inner">
                    <label for="nav-toggle" class="menu-button" aria-label="Open menu" aria-controls="sidebar" role="button" tabindex="0">
                        <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" /></svg>
                    </label>
                    <span class="topbar-title">@moduleName</span>
                    @* Global search (search.js). Without JavaScript the form still goes to the /search results page,
                       and on phones the icon is a plain link to it. *@
                    <a class="search-open" href="/search" aria-label="Search" data-no-prefetch>
                        <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="6.5" /><path d="M16 16l4.5 4.5" /></svg>
                    </a>
                    <form class="search" id="search" method="get" action="/search" role="search">
                        <svg class="search-icon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="6.5" /><path d="M16 16l4.5 4.5" /></svg>
                        <input type="search" name="q" id="search-input" value="@(ViewData["SearchQuery"] as string)" placeholder="Search jobs, customers, people…"
                               autocomplete="off" spellcheck="false" enterkeyhint="search" aria-label="Search everything"
                               role="combobox" aria-expanded="false" aria-controls="search-results" aria-autocomplete="list">
                        <kbd class="search-key" aria-hidden="true">/</kbd>
                        <button type="button" class="search-close" aria-label="Close search">
                            <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" /></svg>
                        </button>
                        <div class="search-results" id="search-results" role="listbox" aria-label="Search results" hidden></div>
                    </form>
                </div>
            </header>
            <main class="page">
                @RenderBody()
            </main>
        </div>
    </div>
    <div class="nav-progress" aria-hidden="true"></div>
    @* Start loading a page when the pointer rests on its link (desktop) or touches it (phone), so it's
       usually ready by the time the click lands. Pages with side effects (sign-in, sign-out, refresh) are left out. *@
    <script type="speculationrules">
    {"prefetch": [{"where": {"and": [
        {"href_matches": "/*"},
        {"not": {"href_matches": "/.auth/*"}},
        {"not": {"href_matches": "/connections*"}},
        {"not": {"selector_matches": "[data-no-prefetch], [href*='refresh='], [href*='handler=']"}}
    ]}, "eagerness": "moderate"}]}
    </script>
    <script src="~/js/nav-feedback.js" asp-append-version="true"></script>
    <script src="~/js/search.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

@inject CurrentUser Me
@{
    // Module pages set ViewData["ModuleName"] to get the "← Dashboard" top bar.
    var moduleName = ViewData["ModuleName"] as string;
    var title = ViewData["Title"] as string;
}
<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="theme-color" content="#2E1248">
    <title>@(title is null ? "" : title + " · ")Purple Painting Dashboard</title>
    <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='7' fill='%236B2FA3'/%3E%3Ctext x='16' y='22' font-family='sans-serif' font-size='18' font-weight='800' fill='white' text-anchor='middle'%3EP%3C/text%3E%3C/svg%3E">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true">
    @await RenderSectionAsync("Head", required: false)
</head>
<body>
    <header class="topbar">
        <div class="topbar-inner">
            @if (moduleName is not null)
            {
                <a class="topbar-back" href="/">← Dashboard</a>
                <span class="topbar-title">@moduleName</span>
            }
            else
            {
                <a class="brand" href="/"><span class="logo">P</span><span>Purple Painting</span></a>
            }
            @if (Me.DisplayName is not null)
            {
                <span class="topbar-user" title="@Me.Email">@Me.DisplayName</span>
            }
        </div>
    </header>
    <main class="page">
        @RenderBody()
    </main>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

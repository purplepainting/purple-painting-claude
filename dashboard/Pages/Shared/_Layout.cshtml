@inject CurrentUser Me
@{
    var title = ViewData["Title"] as string;
    var moduleName = ViewData["ModuleName"] as string ?? title ?? "Dashboard";
}
<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
    <meta name="theme-color" content="#2E1248">
    @* Phone home-screen install (iPhone and Android). The manifest needs credentials because Easy Auth guards every path. *@
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
    <meta name="apple-mobile-web-app-title" content="Purple">
    <link rel="apple-touch-icon" href="~/icons/apple-touch-icon.png">
    <link rel="manifest" href="~/manifest.webmanifest" crossorigin="use-credentials">
    <title>@(title is null ? "" : title + " · ")Purple Painting Dashboard</title>
    <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='7' fill='%236B2FA3'/%3E%3Ctext x='16' y='22' font-family='sans-serif' font-size='18' font-weight='800' fill='white' text-anchor='middle'%3EP%3C/text%3E%3C/svg%3E">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true">
    @await RenderSectionAsync("Head", required: false)
</head>
<body>
    @* The checkbox opens the menu on phones without needing JavaScript. *@
    <input type="checkbox" id="nav-toggle" class="nav-toggle" aria-hidden="true" tabindex="-1">
    <div class="shell">
        <aside class="sidebar" id="sidebar">
            <a class="brand" href="/"><span class="logo">P</span><span>Purple Painting</span></a>
            @await Component.InvokeAsync("SideNav")
            @if (Me.DisplayName is not null)
            {
                <div class="sidebar-user" title="@Me.Email">Signed in as @Me.DisplayName · <a href="/connections">Connections</a> · <a href="/.auth/logout?post_logout_redirect_uri=/">Sign out</a></div>
            }
        </aside>
        <label for="nav-toggle" class="scrim" aria-hidden="true"></label>

        <div class="main">
            <header class="topbar">
                <div class="topbar-inner">
                    <label for="nav-toggle" class="menu-button" aria-label="Open menu" aria-controls="sidebar" role="button" tabindex="0">
                        <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" /></svg>
                    </label>
                    <span class="topbar-title">@moduleName</span>
                </div>
            </header>
            <main class="page">
                @RenderBody()
            </main>
        </div>
    </div>
    <div class="nav-progress" aria-hidden="true"></div>
    <script src="~/js/nav-feedback.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

@model string
@* Simple line icons, 24x24, drawn with currentColor. Add a case to add an icon. *@
<svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
@switch (Model)
{
    case "clipboard":
        <rect x="5" y="4" width="14" height="17" rx="2" /><path d="M9 4h6v3H9zM9 12h6M9 16h4" />
        break;
    case "calendar":
        <rect x="3" y="5" width="18" height="16" rx="2" /><path d="M3 10h18M8 3v4M16 3v4" />
        break;
    case "chart":
        <path d="M4 20V10M10 20V4M16 20v-7M22 20H2" />
        break;
    case "users":
        <circle cx="9" cy="8" r="3.5" /><path d="M2.5 20c.8-3.5 3.4-5.5 6.5-5.5s5.7 2 6.5 5.5M16 4.5a3.5 3.5 0 0 1 0 7M18 14.8c1.8.7 3 2.5 3.5 5.2" />
        break;
    case "megaphone":
        <path d="M3 10v4h4l7 5V5L7 10zM18 8.5a5 5 0 0 1 0 7" />
        break;
    case "receipt":
        <path d="M6 3h12v18l-3-2-3 2-3-2-3 2zM9 8h6M9 12h6M9 16h3" />
        break;
    case "id":
        <rect x="3" y="5" width="18" height="14" rx="2" /><circle cx="9" cy="11" r="2.2" /><path d="M5.8 16c.5-1.5 1.7-2.4 3.2-2.4s2.7.9 3.2 2.4M15 10h3M15 13.5h3" />
        break;
    case "tools":
        <path d="M14.5 5.5a4 4 0 0 0 4.9 4.9l-9 9a2.1 2.1 0 0 1-3-3l9-9a4 4 0 0 0-1.9-1.9zM4 4l3 3" />
        break;
    default:
        <circle cx="12" cy="12" r="8" />
        break;
}
</svg>

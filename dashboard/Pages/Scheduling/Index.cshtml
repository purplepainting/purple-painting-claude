@page "/scheduling"
@model PurpleDashboard.Pages.Scheduling.IndexModel
@using PurpleDashboard.Infrastructure
@using PurpleDashboard.Modules.Scheduling
@using PurpleDashboard.Pages.Scheduling
@{
    var weekStart = LocalClock.WeekStart(Model.Today);
}

<div class="module-head schedule-head">
    <div class="schedule-nav">
        <a class="button secondary icon" asp-page="/Scheduling/Index" asp-all-route-data="Model.Route(Model.Previous)" aria-label="Previous">‹</a>
        <a class="button secondary" asp-page="/Scheduling/Index" asp-all-route-data="Model.Route(Model.IsDay ? Model.Today : weekStart)">Today</a>
        <a class="button secondary icon" asp-page="/Scheduling/Index" asp-all-route-data="Model.Route(Model.Next)" aria-label="Next">›</a>
        <h1 class="schedule-title">@Model.Heading</h1>
    </div>
    <div class="schedule-toggles" data-view-only>
        <div class="segmented" role="group" aria-label="Whose schedule">
            <a class="@(Model.Supervisors ? "" : "active")" asp-page="/Scheduling/Index" asp-all-route-data='Model.Route(who: "crew")'>Crew</a>
            <a class="@(Model.Supervisors ? "active" : "")" asp-page="/Scheduling/Index" asp-all-route-data='Model.Route(who: "supervisors")'>Management</a>
        </div>
        <div class="segmented" role="group" aria-label="Range">
            <a class="@(Model.IsDay ? "active" : "")" asp-page="/Scheduling/Index" asp-all-route-data='Model.Route(Model.IsDay ? Model.From : (Model.Today >= Model.From && Model.Today <= Model.To ? Model.Today : Model.From), "day")'>Day</a>
            <a class="@(Model.IsDay ? "" : "active")" asp-page="/Scheduling/Index" asp-all-route-data='Model.Route(LocalClock.WeekStart(Model.From), "week")'>Week</a>
            <span class="disabled" title="Coming later">Month</span>
        </div>
        @if (!Model.IsDay)
        {
            <div class="segmented" role="group" aria-label="Rows">
                <a class="@(Model.ByPerson ? "" : "active")" asp-page="/Scheduling/Index" asp-all-route-data='Model.Route(by: "job")'>By job</a>
                <a class="@(Model.ByPerson ? "active" : "")" asp-page="/Scheduling/Index" asp-all-route-data='Model.Route(by: "person")'>By person</a>
            </div>
        }
        @if (Model.EditorJson is not null)
        {
            <button type="button" class="button" id="edit-schedule">Edit schedule</button>
        }
    </div>
</div>

@if (Model.Error is not null)
{
    <div class="card notice warn"><strong>Couldn't load the schedule.</strong><p>@Model.Error</p></div>
}
else
{
    <div id="schedule-view">
        <p class="list-meta muted">
            @Model.Tasks.Select(t => t.JobId).Distinct().Count() jobs · @Model.Tasks.SelectMany(t => t.People).Distinct().Count() people · from JobTread at @Model.LoadedAt.ToString("h:mm tt") ·
            <a asp-page="/Scheduling/Index" asp-all-route-data="Model.Route()" asp-route-refresh="true">Refresh</a>
        </p>

        <div class="legend">
            <span class="legend-item">Each job has its own color.</span>
            <span class="legend-item"><span class="pchip lvl-foreman">Foreman</span><span class="pchip lvl-painter">Painter</span><span class="pchip lvl-helper">Helper</span><span class="pchip lvl-supervisor lvl-admin">Admin</span><span class="pchip lvl-supervisor lvl-office">Office</span><span class="pchip lvl-supervisor lvl-sales">Sales</span></span>
            <span class="legend-item"><span class="pchip lvl-painter no-show">Didn't clock in</span><span class="pchip lvl-painter unscheduled">Not scheduled</span> (past days)</span>
        </div>

        @if (Model.Tasks.Count == 0)
        {
            <div class="card empty-state"><p class="muted">No @(Model.Supervisors ? "management" : "crew") tasks in JobTread for this @(Model.IsDay ? "day" : "week").</p></div>
        }
        else
        {
            @if (!Model.IsDay)
            {
                <div class="card schedule-grid-card">
                    <div class="table-wrap">
                        <table class="schedule-grid">
                            <thead>
                                <tr>
                                    <th class="row-head">@(Model.ByPerson ? "Person" : "Job")</th>
                                    @foreach (var day in Model.Days)
                                    {
                                        <th class="@(day == Model.Today ? "today" : "")">@Format.Day(day)</th>
                                    }
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var row in Model.Rows)
                                {
                                    <tr style="@row.ColorStyle">
                                        <th class="row-head" scope="row">
                                            @if (row.ColorStyle is not null) { <span class="swatch"></span> }
                                            <span class="row-title">@row.Title</span>
                                            @if (Model.ByPerson) { <span style="@Model.Team.ChipStyle(row.Title)" class="pchip @Model.Team.ChipClass(row.Title)">@Model.LevelOf(row.Title)</span> }
                                            @if (row.Subtitle is not null) { <span class="row-sub muted">@row.Subtitle</span> }
                                            @if (row.ProjectManager is not null) { <span class="row-pm"><span class="pm-tag" style="@Model.Team.PmStyle(row.ProjectManager)">PM @row.ProjectManager.Split(' ')[0]</span></span> }
                                            @if (Model.ByPerson)
                                            {
                                                var (pa, pe) = Model.PersonWeekCost(row.Title);
                                                if (pa + pe > 0 || Model.PersonWeekHours(row.Title) > 0)
                                                {
                                                    <span class="row-cost num" title="Labor this week: actual @Format.Money(pa)@(pe > 0 ? $", estimated {Format.Money(pe)}" : "")">Week @Format.Money(pa + pe)@if (Model.PersonWeekHours(row.Title) is > 0 and var ph) {<text> · @Format.Number(Math.Round(ph, 1))h</text>}@if (pe > 0) {<span class="muted"> · incl. est.</span>}</span>
                                                }
                                            }
                                            @if (row.JobId is not null)
                                            {
                                                var (wa, we) = Model.WeekCost(row.JobId);
                                                if (wa + we > 0 || Model.WeekHours(row.JobId) > 0)
                                                {
                                                    <span class="row-cost num" title="Labor this week: actual @Format.Money(wa)@(we > 0 ? $", estimated {Format.Money(we)}" : "")">Week @Format.Money(wa + we)@if (Model.WeekHours(row.JobId) is > 0 and var wh) {<text> · @Format.Number(Math.Round(wh, 1))h</text>}@if (we > 0) {<span class="muted"> · incl. est.</span>}</span>
                                                }
                                            }
                                        </th>
                                        @foreach (var day in Model.Days)
                                        {
                                            <td class="@(day == Model.Today ? "today" : "")">
                                                @foreach (var t in row.Cells[day])
                                                {
                                                    <div class="block@(t.Completed ? " done" : "")@(IndexModel.IsMarkedForDeletion(t) ? " marked-delete" : "")" style="@Model.Colors.Style(t.JobId)" title="@t.Name">
                                                        @if (Model.ByPerson)
                                                        {
                                                            <span class="block-title">@t.JobName</span>
                                                            <span class="block-sub">@IndexModel.ShortName(t.Name)</span>
                                                            <span class="block-time">@IndexModel.Time(t)</span>
                                                        }
                                                        else
                                                        {
                                                            <span class="block-title">@IndexModel.ShortName(t.Name)</span>
                                                            <span class="block-time">@IndexModel.Time(t)</span>
                                                            <span class="pchips">
                                                                @if (t.Crew.Count == 0) { <em class="block-sub">Unassigned</em> }
                                                                @foreach (var c in Model.Ordered(t.Crew))
                                                                {
                                                                    var noShow = Model.IsPastOrToday(day) && day < Model.Today && !Model.ClockedIn(t.JobId, day, c.Name);
                                                                    <span style="@Model.Team.ChipStyle(c.Name)" class="pchip @Model.Team.ChipClass(c.Name)@(noShow ? " no-show" : "")" title="@(noShow ? $"{c.Name} was scheduled but didn't clock in" : c.Name)">@c.Name.Split(' ')[0]</span>
                                                                }
                                                            </span>
                                                        }
                                                    </div>
                                                }
                                                @if (row.JobId is not null && Model.Actual.TryGetValue((row.JobId, day), out var actualCrew) && actualCrew.Count > 0)
                                                {
                                                    var scheduled = row.Cells[day].SelectMany(t => t.People).ToHashSet();
                                                    <div class="actual" title="Who clocked in, from JobTread time entries">
                                                        <span class="actual-label">@(day == Model.Today ? "Clocked in so far" : "Actual")</span>
                                                        <span class="pchips">
                                                            @foreach (var (name, hours) in Model.Ordered(actualCrew))
                                                            {
                                                                <span style="@Model.Team.ChipStyle(name)" class="pchip @Model.Team.ChipClass(name)@(scheduled.Contains(name) ? "" : " unscheduled")" title="@name: @Format.Number(hours) hrs@(scheduled.Contains(name) ? "" : " (not scheduled)")">@name.Split(' ')[0] <span class="hrs">@Format.Number(hours)h</span></span>
                                                            }
                                                        </span>
                                                    </div>
                                                }
                                                @if (Model.ByPerson && Model.PersonCosts.TryGetValue((row.Title, day), out var pc))
                                                {
                                                    <div class="day-cost num@(pc.IsEstimate ? " est" : "")" title="@(pc.IsEstimate ? "Estimated: scheduled hours × burdened rate" : "Actual labor from time entries")">@(pc.IsEstimate ? "est. " : "")@IndexModel.CostLabel(pc)</div>
                                                }
                                                @if (row.JobId is not null && Model.Costs.TryGetValue((row.JobId, day), out var dc))
                                                {
                                                    <div class="day-cost num@(dc.IsEstimate ? " est" : "")" title="@(dc.IsEstimate ? "Estimated: crew × scheduled hours × burdened rate" : day == Model.Today ? "Actual labor so far today" : "Actual labor from time entries")">@(dc.IsEstimate ? "est. " : "")@IndexModel.CostLabel(dc)</div>
                                                }
                                            </td>
                                        }
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            }

            @* Day-by-day list: phones, and the Day view everywhere. One card per job, most people first. *@
            <div class="agenda@(Model.IsDay ? " always" : "")">
                @foreach (var day in Model.Days)
                {
                    var buckets = Model.Tasks.Where(t => t.Covers(day))
                        .GroupBy(t => t.JobId)
                        .Select(g => (Job: g.First(), Tasks: g.OrderBy(t => t.StartTime ?? TimeOnly.MinValue).ToList(), Crew: g.SelectMany(t => t.People).Distinct().Count()))
                        .OrderByDescending(x => x.Crew).ThenBy(x => x.Job.JobName)
                        .ToList();
                    if (buckets.Count == 0) { continue; }
                    <section class="agenda-day">
                        <h2 class="@(day == Model.Today ? "today" : "")">@day.ToString("dddd, MMM d")@(day == Model.Today ? " · Today" : "") <span class="muted agenda-count">@buckets.Count jobs · @buckets.Sum(x => x.Crew) people</span></h2>
                        @foreach (var (job, jobTasks, crewCount) in buckets)
                        {
                            <div class="card agenda-job" style="@Model.Colors.Style(job.JobId)">
                                <div class="agenda-top">
                                    <span class="block-title"><span class="swatch"></span> @job.JobName</span>
                                    <span class="agenda-meta">
                                        @if (job.ProjectManager is not null) { <span class="pm-tag" style="@Model.Team.PmStyle(job.ProjectManager)">PM @job.ProjectManager.Split(' ')[0]</span> }
                                        @if (Model.Costs.TryGetValue((job.JobId, day), out var jc)) { <span class="day-cost num@(jc.IsEstimate ? " est" : "")">@(jc.IsEstimate ? "est. " : "")@IndexModel.CostLabel(jc)</span> }
                                    </span>
                                </div>
                                @foreach (var t in jobTasks)
                                {
                                    <div class="agenda-task-row@(t.Completed ? " done" : "")">
                                        <span class="agenda-time num">@IndexModel.Time(t)</span>
                                        <span class="agenda-task">@IndexModel.ShortName(t.Name)</span>
                                        <span class="pchips">
                                            @if (t.Crew.Count == 0) { <em class="muted">Unassigned</em> }
                                            @foreach (var c in Model.Ordered(t.Crew))
                                            {
                                                var noShow = day < Model.Today && !Model.ClockedIn(t.JobId, day, c.Name);
                                                <span style="@Model.Team.ChipStyle(c.Name)" class="pchip @Model.Team.ChipClass(c.Name)@(noShow ? " no-show" : "")">@c.Name.Split(' ')[0]</span>
                                            }
                                        </span>
                                    </div>
                                }
                                @if (Model.Actual.TryGetValue((job.JobId, day), out var actualCrew) && actualCrew.Count > 0)
                                {
                                    var scheduled = jobTasks.SelectMany(t => t.People).ToHashSet();
                                    <div class="actual">
                                        <span class="actual-label">@(day == Model.Today ? "Clocked in so far" : "Actual")</span>
                                        <span class="pchips">
                                            @foreach (var (name, hours) in Model.Ordered(actualCrew))
                                            {
                                                <span style="@Model.Team.ChipStyle(name)" class="pchip @Model.Team.ChipClass(name)@(scheduled.Contains(name) ? "" : " unscheduled")">@name.Split(' ')[0] <span class="hrs">@Format.Number(hours)h</span></span>
                                            }
                                        </span>
                                    </div>
                                }
                                @if (job.Address is not null)
                                {
                                    <a class="agenda-address" href="https://maps.google.com/?q=@Uri.EscapeDataString(job.Address)" target="_blank" rel="noopener">@job.Address</a>
                                }
                            </div>
                        }
                    </section>
                }
            </div>
        }
    </div>

    @if (Model.EditorJson is not null)
    {
        @Html.AntiForgeryToken()
        <div id="schedule-editor" hidden></div>
        <script type="application/json" id="schedule-data">@Html.Raw(Model.EditorJson.Replace("</", "<\\/"))</script>
    }
}

@section Scripts {
    <script src="~/js/schedule-editor.js" asp-append-version="true"></script>
}

@page "/settings/access"
@model PurpleDashboard.Pages.Settings.AccessModel
@using PurpleDashboard.Auth
@{
    string Avatar(string role) => role switch { AccessRoles.Admin => "lvl-admin", AccessRoles.Office => "lvl-office", AccessRoles.Supervisor => "lvl-foreman", _ => "" };
    string Initials(string? name, string email) => string.Concat((name ?? email.Split('@')[0]).Split(' ', '.', '_').Where(p => p.Length > 0).Take(2).Select(p => char.ToUpperInvariant(p[0])));
}

<p class="list-meta muted"><a href="/settings">Settings</a> · Everyone who has opened the dashboard shows up here on their own, as <b>View only</b>. Pick their role, then tick or untick single permissions to change what that role gives them.</p>

@if (Model.Message is not null) { <div class="card notice"><p>@Model.Message</p></div> }

@if (!Model.DatabaseAvailable)
{
    <div class="card notice warn">
        <strong>Roles can't be read or changed right now.</strong>
        <p>The dashboard database isn't available. Until it's back, admins from the ADMIN_EMAILS setting have full access and everyone else is view only.</p>
    </div>
}

<details class="card access-roles">
    <summary><b>What each role can do</b></summary>
    <dl>
        @foreach (var r in AccessRoles.All)
        {
            <div><dt><span class="avatar small @Avatar(r)" aria-hidden="true"></span>@AccessRoles.Label(r)</dt><dd class="muted">@AccessRoles.Describe(r)</dd></div>
        }
    </dl>
    <p class="muted small">People in the ADMIN_EMAILS setting are always Admin, even if the database is down, and can't be changed here.</p>
</details>

<div class="job-list access-list">
    @foreach (var p in Model.People)
    {
        var u = p.Row;
        var role = p.Bootstrap ? AccessRoles.Admin : u.Role;
        <details class="job card emp" id="user-@u.Id" open="@(Model.Open == u.Id)">
            <summary class="emp-row">
                <span class="avatar @Avatar(role)" aria-hidden="true">@Initials(u.Name, u.Email)</span>
                <div class="job-main">
                    <div class="job-title">@(u.Name ?? u.Email)@if (u.Email == Model.MyEmail) { <span class="muted small"> (you)</span> }</div>
                    <div class="job-sub muted">@u.Email</div>
                </div>
                <span class="access-figs">
                    <span class="chip@(role == AccessRoles.Admin ? " active" : "")">@AccessRoles.Label(role)@(p.Bootstrap ? " · ADMIN_EMAILS" : "")</span>
                    @if (p.Overrides.Count > 0) { <span class="chip warn" title="Permissions changed from the role">@p.Overrides.Count change@(p.Overrides.Count == 1 ? "" : "s")</span> }
                    <span class="muted small" title="@PurpleDashboard.Pages.Changes.IndexModel.Exact(u.LastSeenAt)">Seen @PurpleDashboard.Pages.Changes.IndexModel.Relative(u.LastSeenAt)</span>
                </span>
                <span class="chevron" aria-hidden="true"></span>
            </summary>
            <div class="job-detail">
                <form method="post" asp-page-handler="Save" class="access-form" data-access-form>
                    <input type="hidden" name="id" value="@u.Id">
                    <input type="hidden" name="fromRole" value="@role">
                    <fieldset disabled="@(!Model.CanEdit || p.Bootstrap)">
                        <label class="field access-role">
                            <span>Role</span>
                            <select name="role" data-role>
                                @foreach (var r in AccessRoles.All)
                                {
                                    <option value="@r" selected="@(r == role)">@AccessRoles.Label(r)</option>
                                }
                            </select>
                        </label>
                        <div class="table-wrap">
                            <table class="data compact access-table">
                                <thead><tr><th>Area</th><th colspan="3">Permissions <span class="muted small">(<b>bold</b> = changed from the role)</span></th></tr></thead>
                                <tbody>
                                    @foreach (var area in Perm.Areas)
                                    {
                                        <tr>
                                            <th scope="row">@area.Label</th>
                                            @foreach (var k in area.Keys)
                                            {
                                                var on = p.Effective.Contains(k.Key);
                                                var changed = on != p.Defaults.Contains(k.Key);
                                                <td>
                                                    <label class="check access-check@(changed ? " changed" : "")" title="@k.Key · role default: @(p.Defaults.Contains(k.Key) ? "on" : "off")">
                                                        <input type="checkbox" name="perms" value="@k.Key" checked="@on" data-key="@k.Key">
                                                        <span>@k.Label</span>
                                                    </label>
                                                </td>
                                            }
                                            @for (var i = area.Keys.Count; i < 3; i++) { <td></td> }
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                        <div class="form-actions">
                            @if (Model.CanEdit && !p.Bootstrap) { <button class="button" type="submit">Save</button> }
                            @if (p.Bootstrap) { <span class="muted small">Always Admin (ADMIN_EMAILS setting).</span> }
                            <span class="muted small">First seen @PurpleDashboard.Pages.Changes.IndexModel.Relative(u.FirstSeenAt)@(u.UpdatedAt is { } at ? $" · changed {PurpleDashboard.Pages.Changes.IndexModel.Relative(at)} by {u.UpdatedBy}" : "")</span>
                        </div>
                    </fieldset>
                </form>
            </div>
        </details>
    }
    @foreach (var e in Model.AdminsNotSeen)
    {
        <div class="card emp-row">
            <span class="avatar lvl-admin" aria-hidden="true">@Initials(null, e)</span>
            <div class="job-main"><div class="job-title">@e</div><div class="job-sub muted">Hasn't signed in yet</div></div>
            <span class="access-figs"><span class="chip active">Admin · ADMIN_EMAILS</span></span>
        </div>
    }
</div>

<script type="application/json" id="role-defaults">@Html.Raw(PurpleDashboard.Pages.Settings.AccessModel.RoleDefaultsJson())</script>

@section Scripts {
    <script src="~/js/access.js" asp-append-version="true"></script>
}

@page "/projects/{id}/detail"
@model PurpleDashboard.Pages.Projects.DetailModel
@using PurpleDashboard.Infrastructure
@{
    Layout = null;
}
@if (Model.Error is not null)
{
    <p class="notice-inline warn">@Model.Error</p>
}
else if (Model.Detail is { } d)
{
    @if (d.CostCodes.Count == 0)
    {
        <p class="muted">No cost codes or costs on this job yet.</p>
    }
    else
    {
        <h3 class="detail-title">Costs by cost code <span class="muted">(@d.CostCodes.Count codes on this job)</span></h3>
        <div class="table-wrap">
            <table class="data">
                <thead>
                    <tr>
                        <th>Cost code</th>
                        <th class="num">Labor</th>
                        <th class="num">Bills</th>
                        <th class="num">Total</th>
                        <th>Share of costs</th>
                        <th class="num">Hours</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var c in d.CostCodes)
                    {
                        var share = d.ShareOfCost(c);
                        <tr class="@(c.HasCosts ? "" : "no-costs")">
                            <td><span class="num muted">@c.Number</span> @c.Name</td>
                            <td class="num">@Format.Money(c.Labor)</td>
                            <td class="num">@Format.Money(c.Bills)</td>
                            <td class="num">@Format.Money(c.Actual)</td>
                            <td class="used">
                                @if (share is { } s && c.HasCosts)
                                {
                                    <span class="bar"><span style="width:@Math.Min(s, 100).ToString("0", System.Globalization.CultureInfo.InvariantCulture)%"></span></span>
                                    <span class="num">@Format.Percent(s)</span>
                                }
                            </td>
                            <td class="num">@Format.Number(c.Hours)</td>
                        </tr>
                    }
                </tbody>
                <tfoot>
                    <tr>
                        <td>Total</td>
                        <td class="num">@Format.Money(d.CostCodes.Sum(c => c.Labor))</td>
                        <td class="num">@Format.Money(d.CostCodes.Sum(c => c.Bills))</td>
                        <td class="num">@Format.Money(d.TotalActual)</td>
                        <td></td>
                        <td class="num">@Format.Number(d.TotalHours)</td>
                    </tr>
                </tfoot>
            </table>
        </div>
        <p class="muted small">Grayed-out codes are on the job's estimate but have no costs yet. Bills include approved and pending vendor bills.</p>
    }
}

@page "/projects"
@model PurpleDashboard.Pages.Projects.IndexModel
@using PurpleDashboard.Infrastructure
@using PurpleDashboard.Integrations.JobTread
@using PurpleDashboard.Modules.Projects

<div class="module-head">
    <div class="pills" role="tablist" aria-label="Saved views">
        @foreach (var view in ProjectViews.All)
        {
            var active = view.Key == Model.CurrentView.Key;
            <a class="pill@(active ? " active" : "")" asp-page="/Projects/Index" asp-all-route-data="Model.RouteFor(view.Key)" aria-current="@(active ? "page" : null)">
                @view.Label <span class="pill-count num">@Model.ViewCounts.GetValueOrDefault(view.Key)</span>
            </a>
        }
    </div>

    <form class="filters" method="get" data-autosubmit>
        @if (Model.CurrentView != ProjectViews.Default)
        {
            <input type="hidden" name="view" value="@Model.CurrentView.Key">
        }
        <input type="search" name="q" value="@Model.Q" placeholder="Search job, customer, address" aria-label="Search projects">
        <select name="pm" aria-label="Project manager">
            <option value="">All PMs</option>
            @foreach (var pm in Model.ProjectManagers)
            {
                <option value="@pm" selected="@(pm == Model.Pm)">@pm</option>
            }
        </select>
        <select name="type" aria-label="Job type">
            <option value="">All job types</option>
            @foreach (var t in Model.JobTypes)
            {
                <option value="@t" selected="@(t == Model.Type)">@t</option>
            }
        </select>
        <button class="button secondary" type="submit">Apply</button>
        @if (Model.HasFilters)
        {
            <a class="link-button" asp-page="/Projects/Index" asp-route-view="@(Model.CurrentView == ProjectViews.Default ? null : Model.CurrentView.Key)">Clear</a>
        }
    </form>
</div>

@if (Model.Error is not null)
{
    <div class="card notice warn">
        <strong>Couldn't load projects.</strong>
        <p>@Model.Error</p>
    </div>
}
else
{
    <p class="list-meta muted">
        @Model.Jobs.Count @(Model.Jobs.Count == 1 ? "job" : "jobs") · from JobTread at @Model.LoadedAt.ToString("h:mm tt") ·
        <a class="refresh-button" asp-page="/Projects/Index" asp-all-route-data="Model.RouteFor(Model.CurrentView.Key)" asp-route-refresh="true">↻ Refresh</a>
    </p>

    @if (Model.Jobs.Count == 0)
    {
        <div class="card empty-state"><p class="muted">No jobs match this view.</p></div>
    }

    <div class="job-list">
        @foreach (var job in Model.Jobs)
        {
            <details class="job card" data-detail-url="/projects/@job.Id/detail">
                <summary class="job-row">
                    <partial name="_Ring" model="@((job.BilledPercent, "Billed"))" />
                    <div class="job-main">
                        <div class="job-title">
                            <span class="job-num num">#@job.Number</span> @job.Name
                            @if (job.NeedsAttention) { <span class="attention-dot" title="Money waiting on us: open to see why"></span> }
                        </div>
                        <div class="job-sub muted">@(job.Customer ?? "No client")@if (job.ProjectManager is not null) { <span class="pm-tag" style="@Model.Team.PmStyle(job.ProjectManager)">PM @job.ProjectManager.Split(' ')[0]</span> } else { <span class="job-pm"> · no PM</span> }</div>
                        <div class="job-contract num">@(job.Contract is null ? "No contract yet" : Format.Money(job.Contract) + " contract")</div>
                    </div>
                    <dl class="job-line-figs">
                        <div><dt>Costs</dt><dd class="num">@Format.Money(job.ActualCost)</dd></div>
                        <div><dt>Billed</dt><dd class="num@(job.BilledIncludesRetention ? " retention" : "")" title="@(job.BilledIncludesRetention ? $"Includes {Format.Money(job.RetentionHeld)} retention held, earned but not collected yet" : null)">@Format.Money(job.Billed)</dd></div>
                    </dl>
                    <span class="profit num" style="@ProfitScale.Style(job.ProfitPercent)" title="Profit: (billed − costs) ÷ billed. Billed includes retention held.">@Format.Percent(job.ProfitPercent)</span>
                    <span class="chevron" aria-hidden="true"></span>
                </summary>

                <div class="job-detail">
                    @if (job.NeedsAttention || job.CostsOverBilled)
                    {
                        <div class="job-chips">
                            @if (job.IsCompleted && job.HasMoneyOutstanding) { <span class="chip warn">Done, @Format.Money(job.Outstanding) to bill or collect</span> }
                            @if (job.UnsentChangeOrderCount > 0) { <span class="chip warn">@job.UnsentChangeOrderCount unsent @(job.UnsentChangeOrderCount == 1 ? "change order" : "change orders") · @Format.Money(job.UnsentChangeOrders)</span> }
                            @if (job.CostsOverBilled) { <span class="chip warn">Costs ahead of billing</span> }
                        </div>
                    }

                    <div class="job-tabs-row">
                        <div class="segmented job-tabs" role="tablist" aria-label="Job sections">
                            <button type="button" role="tab" class="active" data-tab="costs" aria-selected="true">Costs</button>
                            <button type="button" role="tab" data-tab="crew" aria-selected="false">Crew</button>
                            <button type="button" role="tab" data-tab="details" aria-selected="false">Job details</button>
                        </div>
                        <div class="job-links">
                            <a class="link-button" href="@JobTreadIds.JobUrl(job.Id)" target="_blank" rel="noopener">JobTread ↗</a>
                            @if (job.FolderUrl is not null)
                            {
                                <a class="link-button" href="@job.FolderUrl" target="_blank" rel="noopener">SharePoint ↗</a>
                            }
                        </div>
                    </div>

                    <div class="job-panel" data-panel="details" hidden>
                        <dl class="detail-grid">
                            <div><dt>Job type</dt><dd>@(job.JobTypeShort ?? "—")</dd></div>
                            <div><dt>Address</dt><dd>@(job.Address ?? "—")</dd></div>
                            <div><dt>Stage</dt><dd>@(job.Stage ?? job.BidStage ?? "Bid")</dd></div>
                            <div><dt>Project manager</dt><dd>@(job.ProjectManager ?? "—")</dd></div>
                            <div><dt>Salesperson</dt><dd>@(job.SalesPerson ?? "—")</dd></div>
                            <div><dt>Activity</dt><dd>@Model.Activity(job)</dd></div>
                            <div><dt>Scheduled</dt><dd>@Format.DateRange(job.Start, job.End)</dd></div>
                        </dl>

                        <dl class="detail-grid money">
                            <div>
                                <dt>Contract</dt>
                                <dd class="num">@Format.Money(job.Contract)</dd>
                                @if (job.ContractIncludesPending)
                                {
                                    <dd class="fig-note num">Approved @Format.Money(job.ApprovedContract) · Pending @Format.Money(job.PendingOrders)</dd>
                                }
                                @if (job.PendingOrders > 0 && job.Stage is null)
                                {
                                    <dd class="fig-note num">Proposal pending @Format.Money(job.PendingOrders)</dd>
                                }
                            </div>
                            <div>
                                <dt>Billed</dt>
                                <dd class="num"><span class="@(job.BilledIncludesRetention ? "retention" : "")">@Format.Money(job.Billed)</span> <span class="muted">(@Format.Percent(job.BilledPercent))</span></dd>
                                @if (job.BilledIncludesRetention) { <dd class="fig-note num retention">Incl. @Format.Money(job.RetentionHeld) retention held, earned, not collected yet</dd> }
                            </div>
                            <div><dt>Left to bill</dt><dd class="num">@Format.Money(job.LeftToBill)</dd></div>
                            <div><dt>Unpaid</dt><dd class="num">@Format.Money(job.Unpaid)</dd></div>
                            <div><dt>Costs</dt><dd class="num">@Format.Money(job.ActualCost)</dd></div>
                            <div>
                                <dt>Profit</dt>
                                <dd class="num@(job.Profit < 0 ? " neg" : "")">@Format.Money(job.Profit) <span class="muted">(@Format.Percent(job.ProfitPercent))</span></dd>
                                <dd class="fig-note num">Billed − costs · at full contract @Format.Money(job.ProfitAtContract)</dd>
                            </div>
                            <div><dt>Cash (invoiced − costs)</dt><dd class="num@(job.CashPosition < 0 ? " neg" : "")">@Format.Money(job.CashPosition)</dd></div>
                        </dl>
                    </div>
                    <div class="job-detail-body" aria-live="polite"><p class="muted" data-panel="costs">Loading cost codes…</p></div>
                </div>
            </details>
        }
    </div>
}

@section Scripts {
    <script src="~/js/site.js" asp-append-version="true"></script>
}

@page "/projects"
@model PurpleDashboard.Pages.Projects.IndexModel
@using PurpleDashboard.Infrastructure
@using PurpleDashboard.Integrations.JobTread
@using PurpleDashboard.Modules.Projects

<div class="module-head">
    <div class="pills" role="tablist" aria-label="Saved views">
        @foreach (var view in ProjectViews.All)
        {
            var active = view.Key == Model.CurrentView.Key;
            <a class="pill@(active ? " active" : "")" asp-page="/Projects/Index" asp-all-route-data="Model.RouteFor(view.Key)" aria-current="@(active ? "page" : null)">
                @view.Label <span class="pill-count num">@Model.ViewCounts.GetValueOrDefault(view.Key)</span>
            </a>
        }
    </div>

    <form class="filters" method="get" data-autosubmit>
        @if (Model.CurrentView != ProjectViews.Default)
        {
            <input type="hidden" name="view" value="@Model.CurrentView.Key">
        }
        <input type="search" name="q" value="@Model.Q" placeholder="Search job, customer, address" aria-label="Search projects">
        <select name="pm" aria-label="Project manager">
            <option value="">All PMs</option>
            @foreach (var pm in Model.ProjectManagers)
            {
                <option value="@pm" selected="@(pm == Model.Pm)">@pm</option>
            }
        </select>
        <select name="type" aria-label="Job type">
            <option value="">All job types</option>
            @foreach (var t in Model.JobTypes)
            {
                <option value="@t" selected="@(t == Model.Type)">@t</option>
            }
        </select>
        <button class="button secondary" type="submit">Apply</button>
        @if (Model.HasFilters)
        {
            <a class="link-button" asp-page="/Projects/Index" asp-route-view="@(Model.CurrentView == ProjectViews.Default ? null : Model.CurrentView.Key)">Clear</a>
        }
    </form>
</div>

@if (Model.Error is not null)
{
    <div class="card notice warn">
        <strong>Couldn't load projects.</strong>
        <p>@Model.Error</p>
    </div>
}
else
{
    <p class="list-meta muted">
        @Model.Jobs.Count @(Model.Jobs.Count == 1 ? "job" : "jobs") · from JobTread at @Model.LoadedAt.ToString("h:mm tt") ·
        <a asp-page="/Projects/Index" asp-all-route-data="Model.RouteFor(Model.CurrentView.Key)" asp-route-refresh="true">Refresh</a>
    </p>

    @if (Model.Jobs.Count == 0)
    {
        <div class="card empty-state"><p class="muted">No jobs match this view.</p></div>
    }

    <div class="job-list">
        @foreach (var job in Model.Jobs)
        {
            var band = Model.Bands.For(job.ProfitPercent);
            <details class="job card" data-detail-url="/projects/@job.Id/detail">
                <summary class="job-row">
                    <div class="job-progress">
                        <partial name="_Ring" model="@((job.BilledPercent, "Billed"))" />
                        <span class="job-billed">billed</span>
                    </div>

                    <div class="job-main">
                        <div class="job-title"><span class="job-num num">#@job.Number</span> @job.Name</div>
                        <div class="job-sub muted">@job.Customer@(job.Address is null ? "" : " · " + job.Address)</div>
                        <div class="job-chips">
                            <span class="chip @IndexModel.StageCss(job.Stage)">@(job.Stage ?? job.BidStage ?? "Bid")</span>
                            @if (job.UnsentChangeOrderCount > 0) { <span class="chip warn">@job.UnsentChangeOrderCount unsent @(job.UnsentChangeOrderCount == 1 ? "change order" : "change orders") · @Format.Money(job.UnsentChangeOrders)</span> }
                            @if (job.CostsOverBilled) { <span class="chip warn">Costs ahead of billing</span> }
                            @if (job.JobType is not null) { <span class="tag">@job.JobType</span> }
                            @if (job.ProjectManager is not null) { <span class="tag">PM @job.ProjectManager</span> }
                        </div>
                    </div>

                    <dl class="job-figs">
                        <div><dt>Activity</dt><dd>@Model.Activity(job)</dd></div>
                        <div><dt>Dates</dt><dd>@Format.DateRange(job.Start, job.End)</dd></div>
                        <div><dt>Contract</dt><dd class="num">@Format.Money(job.Contract)</dd></div>
                        @if (job.PendingOrders > 0)
                        {
                            <div><dt>@(job.Stage is null ? "Proposal pending" : "Pending COs")</dt><dd class="num">@Format.Money(job.PendingOrders)</dd></div>
                        }
                        <div><dt>Left to bill</dt><dd class="num">@Format.Money(job.LeftToBill)</dd></div>
                        <div><dt>Billed</dt><dd class="num">@Format.Money(job.Billed)</dd></div>
                        @if (job.RetentionHeld > 0)
                        {
                            <div><dt>Retention held</dt><dd class="num">@Format.Money(job.RetentionHeld)</dd></div>
                        }
                        <div><dt>Costs</dt><dd class="num">@Format.Money(job.ActualCost)</dd></div>
                    </dl>

                    <div class="job-profit">
                        <span class="profit profit-@band.Css num" title="(Contract − costs) ÷ contract">@Format.Percent(job.ProfitPercent)</span>
                        <span class="profit-dollars num@(job.Profit < 0 ? " neg" : "")" title="Contract − costs to date">@Format.Money(job.Profit)</span>
                        <span class="profit-label">@(job.Contract is null ? "No contract yet" : "Profit")@if (job.ProfitPercent is not null) {<span class="profit-band"> · @band.Label</span>}</span>
                        @if (job.PendingOrders > 0 && job.Stage is not null)
                        {
                            <span class="cash num" title="Contract + pending change orders − costs">With pending COs @Format.Money(job.ProfitWithPending)</span>
                        }
                        <span class="cash num@(job.CashPosition < 0 ? " neg" : "")" title="Invoiced after retention − costs">Cash @Format.Money(job.CashPosition)</span>
                    </div>

                    <span class="chevron" aria-hidden="true"></span>
                </summary>

                <div class="job-detail">
                    <div class="job-links">
                        <a class="button secondary" href="@JobTreadIds.JobUrl(job.Id)" target="_blank" rel="noopener">Open in JobTread</a>
                        @if (job.FolderUrl is not null)
                        {
                            <a class="button secondary" href="@job.FolderUrl" target="_blank" rel="noopener">SharePoint folder</a>
                        }
                    </div>
                    <div class="job-detail-body" aria-live="polite"><p class="muted">Loading cost codes…</p></div>
                </div>
            </details>
        }
    </div>
}

@section Scripts {
    <script src="~/js/site.js" asp-append-version="true"></script>
}

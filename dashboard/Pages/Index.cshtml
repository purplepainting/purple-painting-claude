@page
@inject CurrentUser Me
@{
    ViewData["Title"] = null;
}

<section class="hero">
    <h1>Hi, @Me.FirstName</h1>
    <p class="muted">JobTread, QuickBooks and SharePoint in one place.</p>
    <form class="search" role="search" onsubmit="return false">
        <input type="search" name="q" placeholder="Search (coming soon)" aria-label="Search" disabled>
    </form>
</section>

<section class="tiles" aria-label="Modules">
    @foreach (var module in ModuleRegistry.All)
    {
        var live = module.Status == ModuleStatus.Live;
        <a class="tile card@(live ? "" : " is-soon")" href="@module.Route">
            <div class="tile-head">
                <span class="tile-icon"><partial name="_Icon" model="module.Icon" /></span>
                @if (!live)
                {
                    <span class="chip">Coming soon</span>
                }
            </div>
            <h2>@module.Name</h2>
            <p class="muted">@module.Description</p>
            <div class="tile-foot">
                <div>
                    <div class="tile-metric num">—</div>
                    <div class="tile-metric-label">@module.MetricLabel</div>
                </div>
                <span class="tile-source">@module.Source</span>
            </div>
        </a>
    }
</section>

@page "/customers"
@model PurpleDashboard.Pages.Customers.IndexModel
@using PurpleDashboard.Infrastructure
@using PurpleDashboard.Integrations.JobTread
@using PurpleDashboard.Modules.Customers
@using PurpleDashboard.Integrations.Google

<div class="module-head">
    <div class="pills" role="tablist" aria-label="Filters">
        @foreach (var (key, label) in new[] { ((string?)null, "All"), ("owes", "Owes money"), ("review", "Review to request"), ("google", "Google reviews") })
        {
            <a class="pill@(Model.Show == key ? " active" : "")" asp-page="/Customers/Index" asp-route-show="@key" asp-route-q="@Model.Q">@label</a>
        }
    </div>
    <form class="filters" method="get">
        @if (Model.Show is not null) { <input type="hidden" name="show" value="@Model.Show"> }
        <input type="search" name="q" value="@Model.Q" placeholder="Search customer, job or address" aria-label="Search">
        <button class="button secondary" type="submit">Search</button>
    </form>
</div>

@if (Model.Message is not null) { <div class="card notice"><p>@Model.Message</p></div> }
@if (Model.Error is not null)
{
    <div class="card notice warn"><strong>Couldn't load customers.</strong><p>@Model.Error</p></div>
}
else
{
    <div class="kpis">
        <div class="card kpi"><span class="kpi-label">Customers</span><span class="kpi-value num">@Model.All.Count</span><span class="kpi-sub">open jobs + last 12 months</span></div>
        <div class="card kpi"><span class="kpi-label">Owed to us</span><span class="kpi-value num">@Format.Money(Model.All.Sum(c => c.Owes))</span><span class="kpi-sub">@Model.All.Count(c => c.Owes >= 1) customers</span></div>
        <div class="card kpi"><span class="kpi-label">Reviews to request</span><span class="kpi-value num">@Model.All.Count(c => Model.NeedsReview(c))</span><span class="kpi-sub">customers with a completed job</span></div>
        @if (Model.Google.Data is { } gd)
        {
            <a class="card kpi kpi-link" asp-page="/Customers/Index" asp-route-show="google"><span class="kpi-label">Google rating</span><span class="kpi-value num">@(gd.AverageRating is { } avg ? "★ " + avg.ToString("0.0") : "—")</span><span class="kpi-sub">@gd.TotalCount reviews · @Model.Google.ByCustomer.Count matched to customers</span></a>
        }
    </div>
    <p class="list-meta muted">Jobs from JobTread; balances and contact info from QuickBooks (matched by name) · <a class="refresh-button" asp-page="/Customers/Index" asp-route-show="@Model.Show" asp-route-q="@Model.Q" asp-route-refresh="true">↻ Refresh JobTread + QuickBooks@(Model.Google.Ready ? " + Google" : "")</a> @if (PurpleDashboard.Integrations.QuickBooks.QuickBooksClient.DataAsOf is { } qbAsOf) { <span class="muted small">QuickBooks as of @Format.QbAsOf(qbAsOf)</span> } @if (Model.Google.Ready && GoogleClient.ReviewsAsOf is { } gAsOf) { <span class="muted small">· Google reviews as of @Format.QbAsOf(gAsOf)</span> }</p>

    @if (Model.Show == "google")
    {
        <partial name="_GoogleReviews" model="Model" />
    }
    else
    {

    <div class="job-list">
        @if (!Model.Shown.Any()) { <div class="card empty-state"><p class="muted">No customers here.</p></div> }
        @foreach (var c in Model.Shown)
        {
            var chip = Model.ReviewChip(c);
            var r = c.AccountId is { } accountId ? Model.Reviews.GetValueOrDefault(accountId) : null;
            <details class="job card emp">
                <summary class="emp-row">
                    <span class="avatar" aria-hidden="true">@string.Concat(c.Name.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(p => char.ToUpperInvariant(p[0])))</span>
                    <div class="job-main">
                        <div class="job-title">@c.Name</div>
                        <div class="job-sub muted">@c.Jobs.Count @(c.Jobs.Count == 1 ? "job" : "jobs") · billed @Format.Money(c.Billed)@(c.Qb is null ? " · not in QuickBooks" : "")@if (chip is { } ch) { <span class="chip cust-review-chip @ch.Css" title="@ch.Title">@ch.Label</span> }</div>
                    </div>
                    <span class="emp-rates num"><span class="@(c.Owes >= 1 ? "neg" : "muted")">@(c.Owes >= 1 ? "Owes " + Format.Money(c.Owes) : "Paid up")</span><span class="muted">@(c.LastActivity is { } d ? "Last " + Format.Date(d) : "")</span></span>
                    <span class="chevron" aria-hidden="true"></span>
                </summary>
                <div class="job-detail bonus-detail">
                    @if (c.Qb is { } q)
                    {
                        <dl class="detail-grid">
                            <div><dt>Email</dt><dd>@(q.Email is { } e ? Html.Raw($"<a href=\"mailto:{System.Net.WebUtility.HtmlEncode(e)}\">{System.Net.WebUtility.HtmlEncode(e)}</a>") : "—")</dd></div>
                            <div><dt>Phone</dt><dd>@(q.Phone is { } ph ? Html.Raw($"<a href=\"tel:{System.Net.WebUtility.HtmlEncode(ph)}\">{System.Net.WebUtility.HtmlEncode(ph)}</a>") : "—")</dd></div>
                            <div><dt>Billing address</dt><dd>@(q.Address ?? "—")</dd></div>
                            <div><dt>QuickBooks balance</dt><dd class="num">@Format.Money(q.Balance)</dd></div>
                        </dl>
                    }
                    @if (Model.Google.For(c) is { } gm)
                    {
                        <section class="cust-review google-review" aria-label="Google review from @c.Name">
                            <div class="cust-review-head">
                                <b>Google review</b>
                                <span class="stars" aria-label="@gm.Review.Stars out of 5 stars">@IndexModel.Stars(gm.Review.Stars)</span>
                                <span class="muted small">@gm.Review.Reviewer · @gm.Review.Created.ToString("MMM d, yyyy")@(gm.How == "close" ? " · close name match" : "")</span>
                            </div>
                            @if (gm.Review.Comment is { } comment) { <p class="review-text">@comment</p> }
                            @if (gm.Review.Reply is { } reply) { <p class="review-reply"><b>Our reply:</b> @reply</p> }
                            @if (!c.LeftReviewInJobTread)
                            {
                                <p class="muted small">JobTread isn't marked "Left a Review" for this customer yet. The dashboard doesn't change JobTread: if this match is right, update the customer's "Left Review" field in JobTread by hand.</p>
                            }
                        </section>
                    }
                    @if (c.AccountId is not null && Model.Google.For(c) is null && (c.HasCompletedJob || r is not null || c.LeftReviewInJobTread))
                    {
                        var status = r?.Status is "requested" or "later" or "skip" ? r.Status : "requested";
                        <section class="cust-review" aria-label="Review for @c.Name">
                            <div class="cust-review-head">
                                <b>Review</b>
                                @if (chip is { } rc) { <span class="chip @rc.Css" title="@rc.Title">@rc.Label</span> }
                                <span class="muted small">One per customer@(c.Jobs.Count > 1 ? $", covers all {c.Jobs.Count} jobs" : "")</span>
                            </div>
                            @if (c.LeftReviewInJobTread)
                            {
                                <p class="muted small">Marked "Left a Review" on the customer in JobTread. Change it there if that's wrong.</p>
                            }
                            else
                            {
                            <form method="post" asp-page-handler="Review" asp-route-show="@Model.Show" asp-route-q="@Model.Q" class="inline-form">
                                <input type="hidden" name="accountId" value="@c.AccountId"><input type="hidden" name="customerName" value="@c.Name">
                                <label class="field"><span>Status</span>
                                    <select name="status">
                                        <option value="requested" selected="@(status == "requested")">Requested</option>
                                        <option value="later" selected="@(status == "later")">Ask later</option>
                                        <option value="skip" selected="@(status == "skip")">Not asking</option>
                                    </select>
                                </label>
                                <label class="field"><span>Asked for</span>
                                    <select name="platform"><option value="">—</option>@foreach (var p in CustomersService.Platforms) { <option selected="@(r?.Platform == p)">@p</option> }</select>
                                </label>
                                <label class="field grow"><span>Notes</span><input name="notes" value="@r?.Notes"></label>
                                <button class="button secondary" type="submit" disabled="@(!Model.CanEdit)">Save</button>
                            </form>
                            <p class="muted small">When they leave the review, mark "Left a Review" on the customer in JobTread; it shows here automatically.</p>
                            @if (!Model.CanEdit) { <p class="muted small">Saving needs the dashboard database.</p> }
                            }
                        </section>
                    }
                    @foreach (var j in c.Jobs)
                    {
                        <div class="cust-job">
                            <div class="cust-job-head">
                                <b>#@j.Number @j.Name</b>
                                <span class="muted small">@(j.Stage ?? j.BidStage ?? "Bid") · contract @Format.Money(j.Contract) · billed @Format.Money(j.Billed)@(j.Unpaid >= 1 ? " · unpaid " + Format.Money(j.Unpaid) : "")</span>
                                <span class="cust-links">
                                    <a class="link-button" href="@JobTreadIds.JobUrl(j.Id)" target="_blank" rel="noopener">JobTread ↗</a>
                                    @if (j.FolderUrl is not null) { <a class="link-button" href="@j.FolderUrl" target="_blank" rel="noopener">SharePoint ↗</a> }
                                </span>
                            </div>
                        </div>
                    }
                    @if (c.Jobs.Count == 0) { <p class="muted small">No JobTread jobs in the last 12 months; owes money in QuickBooks.</p> }
                </div>
            </details>
        }
    </div>
    }
}

@section Scripts {
    <script src="~/js/site.js" asp-append-version="true"></script>
}

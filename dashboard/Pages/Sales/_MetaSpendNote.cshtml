@model PurpleDashboard.Pages.Sales.IndexModel
@using PurpleDashboard.Modules.Sales
@* Under the lead sources table: where the Facebook/Instagram spend comes from, and manual rows the API replaced. *@
@if (Model.Meta is { State: MetaAdsState.Ready, Report: { } r })
{
    <p class="muted small meta-note">
        <b>@MetaAdsService.Channel</b> spend comes from the Meta API (@(r.AdAccountName ?? r.AdAccountId)) for @Model.From.ToString("MMM yyyy") – @Model.To.ToString("MMM yyyy").
        @if (Model.ReplacedSpend.Count > 0)
        {
            <span>@Model.ReplacedSpend.Count hand-entered row@(Model.ReplacedSpend.Count == 1 ? "" : "s") for the same channel and month (@string.Join(", ", Model.ReplacedSpend.Select(s => $"{s.Channel} {s.Month}"))) @(Model.ReplacedSpend.Count == 1 ? "isn't" : "aren't") counted: Meta's number is used instead, never both.</span>
        }
    </p>
}
else if (Model.Meta is { State: MetaAdsState.NotConnected or MetaAdsState.NoAdAccount })
{
    <p class="muted small meta-note">Facebook/Instagram spend can fill in automatically: <a href="/connections#meta">connect Facebook on Connections</a>.</p>
}

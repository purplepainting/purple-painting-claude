            <a class="card kpi kpi-link drill-kpi" href="@Model.DrillUrl(AdDrilldown.SoldList, ch)" title="List these JobTread jobs"><span class="kpi-label">Jobs sold</span><span class="kpi-value num">@tot.Jobs</span><span class="kpi-sub">open + last year, by the customer's lead source</span></a>

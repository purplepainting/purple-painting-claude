                                <tr class="@(inRange ? "in-period" : "")"><td>@MonthLabel(m.Month)</td><td class="num">@Format.Money(m.Cost)</td><td class="num">@m.Impressions.ToString("#,0")</td><td class="num">@m.Clicks.ToString("#,0")</td><td class="num">@Format.Number(m.Conversions)</td>@if (report.PhoneCallsAvailable) { <td class="num">@m.PhoneCalls?.ToString("#,0")</td> }<td class="num">@Format.Money(m.CostPerLead)</td></tr>

                    </tbody>
                    <tfoot><tr class="total"><td>Total · @dd.Count lead@(dd.Count == 1 ? "" : "s")</td><td></td><td></td><td></td><td data-label="Sold" class="num">@dd.Leads.Count(l => l.Sold) sold</td><td class="num" data-label="Contract">@Format.Money(dd.Contract)</td></tr></tfoot>

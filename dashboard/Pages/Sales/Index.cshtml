                var nonAdSpend = Model.NonAdSpend.Where(l => Model.InChannel(l.Channel)).ToList();
                var flagged = reconRows.Count(r => r.Flag);
                <p class="muted small">@(ch is null ? "Ad spend" : $"{AdChannels.Label(ch)} spend") booked in QuickBooks under 6400 Marketing &amp; Sales (@(booked.Accounts.Count > 0 ? string.Join(", ", booked.Accounts) : "no ad accounts found")), per channel and month, next to what the ad platform reports. 6410 is split by vendor (Facebook/Meta, Nextdoor, Yelp…; anything else is "Other advertising"). <b>Counted</b> is the figure used above: the platform when it's connected, else QuickBooks, else entered by hand. Difference = platform − QuickBooks.</p>
                @if (booked.Problem is not null) { <p class="notice-inline warn small">@booked.Problem</p> }
                @if (flagged > 0)
                {
                    <p class="notice-inline warn small">@flagged @(flagged == 1 ? "month differs" : "months differ") by more than @Format.Money(SalesService.ReconcileMinDollars) and @((SalesService.ReconcileMinShare * 100).ToString("0"))% between the platform and QuickBooks (flagged below).</p>
                }
                @if (replacedBooked.Count > 0)
                {
                    <p class="muted small">QuickBooks figures for @string.Join(" and ", replacedBooked.Select(r => r.Line.Channel).Distinct()) (@Format.Money(replacedBooked.Sum(r => r.Line.Amount)) in this period) are shown for checking only; the platform's figure is counted, never both.</p>
                }
                @if (nonAdSpend.Count > 0)
                {
                    <p class="muted small">@string.Join(" and ", nonAdSpend.Select(l => l.Channel).Distinct(StringComparer.OrdinalIgnoreCase)) (@Format.Money(nonAdSpend.Sum(l => l.Amount)) in this period) @(nonAdSpend.Select(l => l.Channel).Distinct(StringComparer.OrdinalIgnoreCase).Count() == 1 ? "is" : "are") marketing but not ad spend, so @(nonAdSpend.Select(l => l.Channel).Distinct(StringComparer.OrdinalIgnoreCase).Count() == 1 ? "it isn't" : "they aren't") in the Ad spend total or the lead-source table.</p>
                }
                <div class="table-wrap">
                    <table class="data reconcile">
                        <thead><tr><th>Month</th><th>Channel</th><th class="num">Platform reported</th><th class="num">Booked in QuickBooks</th><th class="num">Difference</th><th class="num">Counted</th></tr></thead>
                        <tbody>
                            @foreach (var r in reconRows)
                            {
                                <tr class="@(r.Flag ? "flagged" : "")">
                                    <td>@MonthLabel(r.Month)@if (r.Month == LocalClock.Today.ToString("yyyy-MM")) { <span class="muted small recon-src">so far</span> }</td>
                                    <td>@r.Channel</td>
                                    <td class="num">@(r.PlatformAmount is { } pa ? Format.Money(pa) : "—")@if (r.Platform is not null) { <span class="muted small recon-src">@r.Platform</span> } else { <span class="muted small recon-src">@(string.Equals(r.Channel, Model.GoogleChannel, StringComparison.OrdinalIgnoreCase) || string.Equals(r.Channel, MetaAdsService.Channel, StringComparison.OrdinalIgnoreCase) ? "not connected" : "no API")</span> }</td>
                                    <td class="num">@(r.Booked is { } b ? Format.Money(b) : "—")</td>
                                    <td class="num">@if (r.Difference is { } d) { <span class="@(r.Flag ? "chip warn" : "")">@(d > 0 ? "+" : "")@Format.Money(d)</span> } else { <span>—</span> }</td>
                                    <td class="num">@if (r.NotAdSpend) { <span class="muted">—</span><span class="muted small recon-src">not ad spend</span> } else { @Format.Money(r.Counted)<span class="muted small recon-src">@r.CountedFrom</span> }</td>
                                </tr>
                            }
                            @if (reconRows.Count == 0) { <tr><td colspan="6" class="muted">No ad spend booked in QuickBooks or reported by a platform in this period.</td></tr> }
                        </tbody>
                    </table>
                </div>
                <details class="recon-more">
                    <summary>Why platform and QuickBooks differ</summary>
                    <ul class="muted small">
                        <li><b>Billing timing.</b> Google and Meta charge the card when spend reaches a threshold or at month end, so a charge dated the 1st–3rd is often last month's clicks. It shows as one month high and the next low; over a few months they even out.</li>
                        <li><b>Card charge booked to the wrong account.</b> A Google charge categorized under 6410 (or Meta under 6420, or either under office expenses or a general credit card account). Google charges in 6410 are counted as Google Ads here; ones in non-ad accounts aren't seen at all.</li>
                        <li><b>Not booked yet.</b> Bank-feed transactions still waiting to be categorized in QuickBooks, especially this month (marked "so far").</li>
                        <li><b>Credits and refunds.</b> Platform credits (invalid clicks, promo credits) lower QuickBooks but not always the platform's reported spend.</li>
                        <li><b>Tax and fees.</b> Sales tax or card fees on ad charges make QuickBooks a little higher.</li>
                    </ul>
                </details>
                var inPeriod = booked.Lines.Where(l => Model.InChannel(l.Channel) && string.CompareOrdinal(l.Month, Model.From.ToString("yyyy-MM")) >= 0 && string.CompareOrdinal(l.Month, Model.To.ToString("yyyy-MM")) <= 0).OrderByDescending(l => l.Date).ToList();
                @if (inPeriod.Count > 0)
                {
                    <details class="recon-more">
                        <summary>QuickBooks lines in this period (@inPeriod.Count)</summary>
                        <div class="table-wrap">
                            <table class="data">
                                <thead><tr><th>Date</th><th>Account</th><th>Vendor</th><th>Channel</th><th class="num">Amount</th></tr></thead>
                                <tbody>
                                    @foreach (var l in inPeriod)
                                    {
                                        <tr><td>@Format.Date(l.Date)</td><td>@l.Account</td><td>@(l.Vendor ?? l.Memo ?? "—")</td><td>@l.Channel</td><td class="num">@Format.Money(l.Amount)</td></tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </details>
                }
            }
        </section>

    @if (ch is null or AdChannels.Other)
    {
        @if (Model.CanEditAds)
        {
            <section class="card fin-section">
                <details class="recon-more spend-add" open="@(!qbReady && Model.ApiChannels.Count == 0)">
                    <summary>Add spend not in QuickBooks</summary>
                    <p class="muted small">Only for spend that isn't booked in QuickBooks@(Model.ApiChannels.Count > 0 ? $" and doesn't come from an API ({apiNames})" : "") (e.g. paid on a personal card). A month and channel QuickBooks already has isn't counted twice: QuickBooks wins.</p>
                    <form method="post" asp-page-handler="Spend" asp-all-route-data="Model.AdsRoute()" class="inline-form wrap">
                        <label class="field"><span>Month</span><input type="month" name="month" value="@LocalClock.Today.ToString("yyyy-MM")" required></label>
                        <label class="field"><span>Channel</span><input name="spendChannel" list="channels" required placeholder="e.g. Nextdoor"></label>
                        <datalist id="channels">@foreach (var s in Model.Sources.Where(s => !s.NoLeadSource)) { <option value="@s.Source"></option> }</datalist>
                        <label class="field"><span>Amount</span><input name="amount" inputmode="decimal" required style="width:120px"></label>
                        <label class="field"><span>Leads (optional)</span><input type="number" name="leads" min="0" style="width:110px"></label>
                        <button class="button" type="submit">Save</button>
                    </form>
                    <p class="muted small">Use the channel names in the lead source table (JobTread's Lead Source; "Nextdoor", "Google Ads", "Facebook/Instagram" and their usual spellings line up automatically). Saving the same month and channel again replaces it.</p>
                </details>
            </section>
        }
    }

        @if (spendRows.Count > 0)
        {
            <section class="card fin-section">
                <h2 class="section-title">Spend entered@(ch is null ? "" : $" · {AdChannels.Label(ch)}")</h2>
                <div class="table-wrap">
                    <table class="data">
                        <thead><tr><th>Month</th><th>Channel</th><th class="num">Amount</th><th class="num">Leads</th><th></th></tr></thead>
                        <tbody>
                            @foreach (var s in spendRows)
                            {
                                var r = Model.ReplacedSpend.GetValueOrDefault(s.Id);
                                var by = r is null ? "" : r.ApiName == QuickBooksAdSpendService.SourceName ? "QuickBooks" : "API";
                                <tr class="@(r is not null ? "replaced" : "")"><td>@s.Month</td><td>@s.Channel@if (r is not null) { <span class="chip warn api-chip" title="@SalesService.SourceLabel(r.ApiName) for @s.Month: @Format.Money(r.ApiAmount)">Not counted · @by: @Format.Money(r.ApiAmount)</span> }</td><td class="num">@Format.Money(s.Amount)</td><td class="num">@(s.Leads?.ToString() ?? "—")</td>
                                    <td>@if (Model.CanEditAds) { <form method="post" asp-page-handler="DeleteSpend" asp-all-route-data="Model.AdsRoute()" onsubmit="return confirm('Delete?')"><input type="hidden" name="id" value="@s.Id"><button class="link-button" type="submit">Delete</button></form> }</td></tr>
                            }
                        </tbody>
                    </table>
                </div>
            </section>
        }
    }
}

@functions {
    static string IndexModelPct(decimal part, decimal whole) => whole == 0 ? "—" : Format.Percent(100m * part / whole);
    static string MonthLabel(string month) => DateOnly.TryParseExact(month + "-01", "yyyy-MM-dd", out var d) ? d.ToString("MMM yyyy", System.Globalization.CultureInfo.GetCultureInfo("en-US")) : month;
    static string AdsAccountId(string? id) => id is null ? "" : AdsAccount.FormatId(id);

    /// <summary>A row of the lead source table (Ads → revenue by lead source on All, Other channels on Other).</summary>
    void SourceRow(LeadSource s)
    {
        var isQb = s.ApiSource == QuickBooksAdSpendService.SourceName;
        <tr class="@(s.NoLeadSource ? "muted" : "")"><td>@s.Source@if (s.FromApi) { <span class="chip @(isQb ? "" : "good") api-chip" title="@(isQb ? "Spend booked in QuickBooks" : $"Spend and leads from the {s.ApiSource} API")">@(isQb ? "QB" : "API")</span> }</td><td class="num">@{ DrillLink(s.Jobs, Model.DrillUrl(AdDrilldown.SoldList, source: s.Source)); }</td><td class="num">@Format.Money(s.Contract)</td><td class="num">@(s.Spend > 0 ? Format.Money(s.Spend) : "—")</td><td class="num">@(s.Leads is { } l ? Format.Number(l) : "—")</td><td class="num">@{ DrillLink(s.JtLeads, Model.DrillUrl(AdDrilldown.LeadsList, source: s.Source)); }</td><td class="num">@(s.CostPerJtLead is { } cpl ? Format.Money(cpl) : "—")</td><td class="num" title="@(s.CloseRate is not null ? $"{s.WonLeads} of {s.JtLeads} new accounts have a sold job" : "")">@(s.CloseRate is { } cr ? Format.Percent(100m * cr) : "—")</td><td class="num">@(s.Spend > 0 ? (s.Contract / s.Spend).ToString("$0.00") : "—")</td></tr>
    }

    /// <summary>A lead or jobs-sold figure as a link to the JobTread records behind it (plain when there's nothing to list).</summary>
    void DrillLink(int? n, string? href)
    {
        if (n is null) { <text>—</text> }
        else if (n == 0 || href is null) { <text>@n.Value.ToString("#,0")</text> }
        else { <a class="drill" href="@href" title="List them">@n.Value.ToString("#,0")</a> }
    }

    void DrillCount(int? n, string list, ChannelSummary c) => DrillLink(n, Model.DrillUrl(list, c));

    /// <summary>The figures of a "By channel" row (after the channel name).</summary>
    void ChannelCells(ChannelSummary c)
    {
        <td class="num">@(c.Kind == AdChannels.NoLeadSource ? "—" : Format.Money(c.Spend))</td>
        <td class="small">@(c.Kind == AdChannels.NoLeadSource ? "" : c.SpendFromLabel)</td>
        <td class="num">@(c.Clicks?.ToString("#,0") ?? "—")</td>
        <td class="num">@{ DrillCount(c.JtLeads, AdDrilldown.LeadsList, c); }</td>
        <td class="num" title="@(c.CloseRate is not null ? $"{c.WonLeads} of {c.JtLeads} new accounts have a sold job" : "")">@(c.CloseRate is { } cr ? Format.Percent(100m * cr) : "—")</td>
        <td class="num">@{ DrillCount(c.Jobs, AdDrilldown.SoldList, c); }</td>
        <td class="num">@Format.Money(c.Contract)</td>
        <td class="num">@(c.CostPerLead is { } cpl ? Format.Money(cpl) : "—")</td>
        <td class="num">@(c.CostPerSoldJob is { } cps ? Format.Money(cps) : "—")</td>
    }
}

@section Scripts {
    <script src="~/js/site.js" asp-append-version="true"></script>
}

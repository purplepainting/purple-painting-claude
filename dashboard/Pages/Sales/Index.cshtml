@page "/sales"
@model PurpleDashboard.Pages.Sales.IndexModel
@using PurpleDashboard.Infrastructure
@using PurpleDashboard.Integrations.JobTread
@using PurpleDashboard.Modules.Sales
@using PurpleDashboard.Integrations.Google

<div class="module-head">
    <div class="pills" role="tablist" aria-label="Sales sections">
        @foreach (var (key, label) in Model.Tabs)
        {
            <a class="pill@(Model.CurrentTab == key ? " active" : "")" asp-page="/Sales/Index" asp-route-tab="@(key == "commissions" ? null : key)">@label</a>
        }
    </div>
    @if (Model.CurrentTab != "commissions")
    {
        <form class="filters" method="get" data-autosubmit>
            <input type="hidden" name="tab" value="@Model.CurrentTab">
            <select name="period" aria-label="Period">
                <option value="30" selected="@(Model.Period == "30")">Last 30 days</option>
                <option value="" selected="@(Model.Period is null or "90")">Last 90 days</option>
                <option value="ytd" selected="@(Model.Period == "ytd")">Year to date</option>
                @if (Model.CurrentTab == "ads") { <option value="12" selected="@(Model.Period == "12")">Last 12 months</option> }
            </select>
        </form>
    }
</div>

@if (Model.Message is not null && Model.Open is null) { <div class="card notice"><p>@Model.Message</p></div> }
@if (!Model.CanEdit) { <div class="card notice warn"><p>The dashboard database isn't available, so nothing can be saved right now.</p></div> }
@if (Model.Error is not null) { <div class="card notice warn"><strong>Couldn't load.</strong><p>@Model.Error</p></div> }

@if (Model.CurrentTab == "commissions" && Model.Error is null)
{
    <p class="list-meta muted">Salesperson comes from each job in JobTread. @(Model.CanEditCommissions ? "Set each person's rate below; " : "")"collected" pays as the customer pays (invoices minus unpaid, before retention).</p>

    <section class="card fin-section">
        <h2 class="section-title">Salespeople</h2>
        <div class="table-wrap">
            <table class="data">
                <thead><tr><th>Person</th><th>Rate</th><th class="num">Jobs</th><th class="num">Earned</th><th class="num">Paid</th><th class="num">Owed</th></tr></thead>
                <tbody>
                    @foreach (var p in Model.People)
                    {
                        <tr>
                            <td>
                                @if (!Model.CanEditCommissions) { <b>@p.Person</b> } else {
                                <details class="acct-list">
                                    <summary><b>@p.Person</b></summary>
                                    <form method="post" asp-page-handler="Rule" class="inline-form">
                                        <input type="hidden" name="person" value="@p.Person">
                                        <input name="percent" inputmode="decimal" value="@(p.Rule?.Percent.ToString("0.##"))" placeholder="%" aria-label="Commission percent" style="width:70px" required>
                                        <select name="basis" aria-label="Commission based on">
                                            @foreach (var b in SalesService.Bases) { <option value="@b" selected="@((p.Rule?.Basis ?? "collected") == b)">% @SalesService.BasisLabel(b)</option> }
                                        </select>
                                        <input name="notes" value="@p.Rule?.Notes" placeholder="Notes (optional)" aria-label="Notes">
                                        <button class="button secondary" type="submit">Save</button>
                                    </form>
                                </details>
                                }
                            </td>
                            <td class="@(p.Rule is null ? "neg" : "")">@IndexModel.Rate(p.Rule)</td>
                            <td class="num">@p.Jobs</td>
                            <td class="num">@Format.Money(p.Earned)</td>
                            <td class="num">@Format.Money(p.Paid + p.Unallocated)@if (p.Unallocated != 0) { <div class="muted small" title="Paid through payroll beyond their owed jobs; lowers what they're owed">incl. @Format.Money(p.Unallocated) unallocated</div> }</td>
                            <td class="num"><b>@Format.Money(p.Owed)</b></td>
                        </tr>
                    }
                    <tr class="total"><td>Total</td><td></td><td class="num">@Model.People.Sum(p => p.Jobs)</td><td class="num">@Format.Money(Model.People.Sum(p => p.Earned))</td><td class="num">@Format.Money(Model.People.Sum(p => p.Paid + p.Unallocated))</td><td class="num">@Format.Money(Model.People.Sum(p => p.Owed))</td></tr>
                </tbody>
            </table>
        </div>
    </section>

    <div class="pills">
        <a class="pill@(Model.Show != "all" ? " active" : "")" asp-page="/Sales/Index">Owed</a>
        <a class="pill@(Model.Show == "all" ? " active" : "")" asp-page="/Sales/Index" asp-route-show="all">All jobs</a>
    </div>
    <div class="job-list" style="margin-top:10px">
        @if (Model.Show != "all" && Model.JobsWithoutRate > 0)
        {
            <p class="list-meta muted">@Model.JobsWithoutRate job@(Model.JobsWithoutRate == 1 ? "" : "s") can't owe anything until the salesperson has a commission rate: set rates in the table above, or see <a asp-page="/Sales/Index" asp-route-show="all">All jobs</a>.</p>
        }
        @if (!Model.ShownCommissions.Any()) { <div class="card empty-state"><p class="muted">Nothing owed right now.</p></div> }
        @foreach (var c in Model.ShownCommissions)
        {
            var jobPayments = Model.Payments.Where(p => p.JobId == c.JobId).OrderByDescending(p => p.PaidOn).ThenByDescending(p => p.Id).ToList();
            <details class="job card emp" id="comm-@c.JobId" open="@(Model.Open == c.JobId)">
                <summary class="emp-row with-chip">
                    <span class="chip">@c.Person.Split(' ')[0]</span>
                    <div class="job-main">
                        <div class="job-title">#@c.Number @c.JobName</div>
                        <div class="job-sub muted">@c.Stage · contract @Format.Money(c.Contract) · collected @Format.Money(c.Collected)</div>
                    </div>
                    <span class="emp-rates num"><span>Earned @Format.Money(c.Earned)</span><span class="muted">Paid @Format.Money(c.Paid)</span></span>
                    <span class="emp-hours num"><b>@(c.Rule is null ? "set rate" : Format.Money(c.Owed))</b></span>
                    <span class="chevron" aria-hidden="true"></span>
                </summary>
                <div class="job-detail bonus-detail">
                    <p class="muted small">@c.Person: @IndexModel.Rate(c.Rule) · job profit @Format.Money(c.Profit) · <a href="@JobTreadIds.JobUrl(c.JobId)" target="_blank" rel="noopener">JobTread ↗</a></p>
                    @if (Model.CanEditCommissions)
                    {
                        <form method="post" asp-page-handler="Pay" asp-route-show="@Model.Show" class="inline-form">
                            <input type="hidden" name="jobId" value="@c.JobId"><input type="hidden" name="jobName" value="@c.JobName"><input type="hidden" name="person" value="@c.Person">
                            <input name="amount" inputmode="decimal" value="@(c.Owed > 0 ? c.Owed.ToString("0.00") : "")" placeholder="Amount" aria-label="Amount paid" style="width:110px" required>
                            <input type="date" name="paidOn" value="@LocalClock.Today.ToString("yyyy-MM-dd")" aria-label="Paid on">
                            <input name="note" placeholder="Note (e.g. check #, payroll date)" aria-label="Note">
                            <button class="button" type="submit">Record payment</button>
                        </form>
                    }
                    @if (Model.Open == c.JobId && Model.Message is not null) { <p class="notice-inline good">@Model.Message</p> }
                    @if (jobPayments.Count > 0)
                    {
                        <table class="data compact" style="margin-top:8px">
                            <thead><tr><th>Paid</th><th class="num">Amount</th><th>Note</th><th></th></tr></thead>
                            <tbody>
                                @foreach (var p in jobPayments)
                                {
                                    <tr>
                                        <td>@Format.Date(p.PaidOn)</td><td class="num">@Format.Money(p.Amount)</td><td class="muted">@p.Note</td>
                                        <td>@if (Model.IsLocked(p.Person, p.PaidOn)) { <span class="muted small" title="Paid & locked month">🔒</span> } else if (Model.CanEditCommissions) { <form method="post" asp-page-handler="DeletePayment" asp-route-show="@Model.Show" onsubmit="return confirm('Delete this payment record?')"><input type="hidden" name="id" value="@p.Id"><input type="hidden" name="jobId" value="@c.JobId"><button class="link-button" type="submit">Delete</button></form> }</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                </div>
            </details>
        }
    </div>

    @if (Model.Checks is { } chk)
    {
        var cm = chk.Month;
        var cmKey = CommissionPayroll.Key(cm);
        var cmLabel = CommissionPayroll.Label(cm);
        string Cents(decimal d) => d.ToString("$#,##0.00;-$#,##0.00");
        bool InlineFor(string id) => Model.Open == id && Model.Message is not null;
        <section class="fin-section-plain" id="checks" style="margin-top:16px">
            <div style="display:flex;flex-wrap:wrap;gap:8px;align-items:center;justify-content:space-between">
                <h2 class="section-title">Payroll checks · @cmLabel</h2>
                <form method="get" data-autosubmit class="filters">
                    @if (Model.Show is not null) { <input type="hidden" name="show" value="@Model.Show"> }
                    <select name="month" aria-label="Payroll month">
                        @foreach (var m in CommissionPayroll.Months()) { <option value="@CommissionPayroll.Key(m)" selected="@(m == cm)">@CommissionPayroll.Label(m)</option> }
                    </select>
                </form>
            </div>
            @if (!chk.Payroll.Ok)
            {
                <div class="card notice warn"><p>@chk.Payroll.Problem</p></div>
            }
            else
            {
                <p class="muted small">"Commission" paycheck lines posted in QuickBooks in @cmLabel (@string.Join(", ", chk.Payroll.Accounts)), gross, matched to salespeople by QuickBooks employee id, then name, and compared with the commission payments recorded here dated in @cmLabel (tolerance $1). Owed now is today's balance on all their jobs.
                    @if (Model.QbAsOf is { } asOf) { <span>QuickBooks as of @asOf.ToLocalTime().ToString("MMM d h:mm tt") · <a asp-page="/Sales/Index" asp-route-month="@cmKey" asp-route-show="@Model.Show" asp-route-qbRefresh="true" asp-fragment="checks">Refresh</a></span> }</p>
                <details class="acct-list small" style="margin-bottom:8px">
                    <summary>How "Record from payroll" and locking work</summary>
                    <p class="muted small"><b>Record from payroll</b> records what payroll paid beyond what's recorded here, dated on the check: it pays off the person's owed jobs oldest first (lowest JobTread job number), and anything left over (payroll paid more than their jobs owe, e.g. an advance) is kept as one <b>unallocated</b> payment that lowers their owed total. Delete it under Recent payments if it was a mistake.</p>
                    <p class="muted small"><b>Paid &amp; locked</b> saves a snapshot of the person's month (each job's commission earned and what was paid in @cmLabel, the check and gross). Payments dated in a locked month can't be added or deleted. If a job's commission changes later (JobTread contract, collected or profit), the change shows in the next open month as an adjustment; it's already counted in owed now. Unlocking needs a reason and is change-logged.</p>
                </details>
                @if (InlineFor("checks")) { <p class="notice-inline good">@Model.Message</p> }
                <div class="card table-wrap">
                    <table class="data stack-phone">
                        <thead><tr><th>Salesperson</th><th class="num">Owed now</th><th class="num">Recorded in @cm.ToString("MMM")</th><th class="num">Payroll (gross)</th><th>Checks</th><th>Status</th><th></th></tr></thead>
                        <tbody>
                            @if (chk.Rows.Count == 0) { <tr><td colspan="7" class="muted">No commission owed, recorded or paid through payroll in @cmLabel.</td></tr> }
                            @foreach (var c in chk.Rows)
                            {
                                var slug = IndexModel.Slug(c.Name);
                                <tr id="chk-@slug">
                                    <td>@c.Name</td>
                                    <td class="num" data-label="Owed now">@Cents(c.OwedNow)</td>
                                    <td class="num" data-label="Recorded in @cm.ToString("MMM")">@Cents(c.Recorded)</td>
                                    <td class="num" data-label="Payroll (gross)">@Cents(c.Payroll)</td>
                                    <td class="small" data-label="Checks">@foreach (var ch in c.Checks) { <div>#@(ch.Num ?? "—") · @Format.Date(ch.Date) · @Cents(ch.Amount)</div> }@if (c.Checks.Count == 0) { <span class="muted">—</span> }</td>
                                    <td>
                                        <span class="chip @c.Chip">@(c.Lock is not null ? "🔒 " : "")@c.Status</span>
                                        @if (c.Detail is { } d) { <div class="muted small">@d</div> }
                                        @if (c.Lock is { } lk) { <div class="muted small">by @lk.LockedBy @Format.Date(DateOnly.FromDateTime(lk.LockedAt.ToLocalTime())): paid @Cents(lk.Net)@(lk.Gross is { } g ? $", gross {Cents(g)}" : "")@(lk.CheckNum is { } cn ? $", check {cn}" : "")</div> }
                                        @if (c.Adjustment is { } adj) { <div class="small @(adj.Amount < 0 ? "neg" : "")">Adjustment for @CommissionPayroll.Label(adj.LockedMonth): @(adj.Amount > 0 ? "+" : "")@Cents(adj.Amount) (@string.Join(", ", adj.Jobs) changed after it was locked; in owed now)</div> }
                                    </td>
                                    <td class="actions">
                                        @if (Model.CanEditCommissions && c.Unrecorded > 0 && c.Lock is null)
                                        {
                                            <form method="post" asp-page-handler="PayFromPayroll" asp-route-month="@cmKey" asp-route-show="@Model.Show"><input type="hidden" name="person" value="@c.Name"><button class="button secondary" type="submit" title="Record @Cents(c.Unrecorded) from the payroll check">Record from payroll</button></form>
                                        }
                                        @if (Model.CanEditCommissions && c.CanLock)
                                        {
                                            <form method="post" asp-page-handler="Lock" asp-route-month="@cmKey" asp-route-show="@Model.Show" onsubmit="@(c.Unrecorded > 0 ? "return confirm(" + System.Text.Json.JsonSerializer.Serialize($"Record {Cents(c.Unrecorded)} from payroll and lock {c.Name} for {cmLabel}?") + ")" : null)"><input type="hidden" name="person" value="@c.Name"><button class="link-button" type="submit">Lock</button></form>
                                        }
                                        @if (Model.CanEditCommissions && c.Lock is not null)
                                        {
                                            <details class="unlock"><summary class="link-button">Unlock</summary>
                                                <form method="post" asp-page-handler="Unlock" asp-route-month="@cmKey" asp-route-show="@Model.Show" class="inline-form"><input type="hidden" name="person" value="@c.Name"><input name="reason" placeholder="Reason (required)" aria-label="Reason for unlocking" required><button class="button secondary" type="submit">Unlock</button></form>
                                            </details>
                                        }
                                    </td>
                                </tr>
                                @if (c.Payments.Count > 0)
                                {
                                    <tr><td colspan="7" class="small muted" style="font-weight:400">Recorded: @string.Join(" · ", c.Payments.Select(p => $"{Format.Date(p.PaidOn)} {Cents(p.Amount)} {(p.JobId == CommissionPayroll.Unallocated ? "unallocated" : p.JobName)}"))</td></tr>
                                }
                                @if (InlineFor("chk-" + slug)) { <tr><td colspan="7"><p class="notice-inline good">@Model.Message</p></td></tr> }
                            }
                        </tbody>
                        <tfoot><tr><td>Total</td><td class="num" data-label="Owed now">@Cents(chk.Rows.Sum(x => x.OwedNow))</td><td class="num" data-label="Recorded in @cm.ToString("MMM")">@Cents(chk.Rows.Sum(x => x.Recorded))</td><td class="num" data-label="Payroll (gross)">@Cents(chk.Rows.Sum(x => x.Payroll))</td><td colspan="3"></td></tr></tfoot>
                    </table>
                </div>
                @if (Model.CanEditCommissions && chk.Rows.Any(x => x.ReadyToLock))
                {
                    <form method="post" asp-page-handler="Lock" asp-route-month="@cmKey" asp-route-show="@Model.Show" class="form-actions" style="margin-top:10px" onsubmit="return confirm('Lock everyone whose payroll check matches what is recorded for @cmLabel?')">
                        <button class="button" type="submit">Lock @cmLabel</button>
                        <span class="muted small">Locks everyone whose check matches. Others stay open (Record from payroll first, or Lock them one by one).</span>
                    </form>
                }
            }
        </section>
    }

    @if (Model.Payments.Count > 0)
    {
        <section class="card fin-section" style="margin-top:12px">
            <h2 class="section-title">Recent payments</h2>
            <div class="table-wrap">
                <table class="data">
                    <thead><tr><th>Paid</th><th>Person</th><th>Job</th><th class="num">Amount</th><th>Note</th><th></th></tr></thead>
                    <tbody>
                        @foreach (var p in Model.Payments)
                        {
                            <tr>
                                <td>@Format.Date(p.PaidOn)</td><td>@p.Person</td><td>@p.JobName</td><td class="num">@Format.Money(p.Amount)</td><td class="muted">@p.Note</td>
                                <td>@if (Model.IsLocked(p.Person, p.PaidOn)) { <span class="muted small" title="Paid & locked month">🔒</span> } else if (Model.CanEditCommissions) { <form method="post" asp-page-handler="DeletePayment" asp-route-show="@Model.Show" onsubmit="return confirm('Delete this payment record?')"><input type="hidden" name="id" value="@p.Id"><button class="link-button" type="submit">Delete</button></form> }</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </section>
    }
}
else if (Model.CurrentTab == "doors" && Model.Error is null)
{
    var a = Model.Activity;
    <div class="kpis">
        <div class="card kpi"><span class="kpi-label">Doors</span><span class="kpi-value num">@a.Sum(x => x.Doors).ToString("#,0")</span></div>
        <div class="card kpi"><span class="kpi-label">Leads</span><span class="kpi-value num">@a.Sum(x => x.Leads)</span><span class="kpi-sub num">@IndexModelPct(a.Sum(x => x.Leads), a.Sum(x => x.Doors)) of doors</span></div>
        <div class="card kpi"><span class="kpi-label">Sold</span><span class="kpi-value num">@a.Sum(x => x.Sold)</span><span class="kpi-sub num">@IndexModelPct(a.Sum(x => x.Sold), a.Sum(x => x.Leads)) of leads</span></div>
        <div class="card kpi"><span class="kpi-label">Sold $</span><span class="kpi-value num">@Format.Money(a.Sum(x => x.SoldAmount))</span></div>
    </div>

    @if (Model.CanEditDoors)
    {
        <section class="card fin-section">
            <h2 class="section-title">Log activity</h2>
            <form method="post" asp-page-handler="Activity" asp-route-period="@Model.Period" class="inline-form wrap">
                <label class="field"><span>Date</span><input type="date" name="date" value="@LocalClock.Today.ToString("yyyy-MM-dd")"></label>
                <label class="field"><span>Rep</span><input name="rep" required list="reps"></label>
                <datalist id="reps">@foreach (var r in a.Select(x => x.Rep).Distinct()) { <option value="@r"></option> }</datalist>
                <label class="field"><span>Doors</span><input type="number" name="doors" min="0" value="0" style="width:90px"></label>
                <label class="field"><span>Leads</span><input type="number" name="leads" min="0" value="0" style="width:90px"></label>
                <label class="field"><span>Sold</span><input type="number" name="sold" min="0" value="0" style="width:90px"></label>
                <label class="field"><span>Sold $</span><input name="soldAmount" inputmode="decimal" style="width:110px"></label>
                <label class="field grow"><span>Notes</span><input name="notes"></label>
                <button class="button" type="submit">Log</button>
            </form>
        </section>
    }

    <section class="card fin-section">
        <h2 class="section-title">By rep</h2>
        <div class="table-wrap">
            <table class="data">
                <thead><tr><th>Rep</th><th class="num">Days</th><th class="num">Doors</th><th class="num">Leads</th><th class="num">Sold</th><th class="num">Sold $</th></tr></thead>
                <tbody>
                    @foreach (var g in a.GroupBy(x => x.Rep).OrderByDescending(g => g.Sum(x => x.SoldAmount)))
                    {
                        <tr><td>@g.Key</td><td class="num">@g.Select(x => x.Date).Distinct().Count()</td><td class="num">@g.Sum(x => x.Doors)</td><td class="num">@g.Sum(x => x.Leads)</td><td class="num">@g.Sum(x => x.Sold)</td><td class="num">@Format.Money(g.Sum(x => x.SoldAmount))</td></tr>
                    }
                    @if (a.Count == 0) { <tr><td colspan="6" class="muted">Nothing logged in this period.</td></tr> }
                </tbody>
            </table>
        </div>
    </section>

    @if (a.Count > 0)
    {
        <section class="card fin-section">
            <h2 class="section-title">Log</h2>
            <div class="table-wrap">
                <table class="data">
                    <thead><tr><th>Date</th><th>Rep</th><th class="num">Doors</th><th class="num">Leads</th><th class="num">Sold</th><th class="num">Sold $</th><th>Notes</th><th></th></tr></thead>
                    <tbody>
                        @foreach (var x in a)
                        {
                            <tr><td>@Format.Date(x.Date)</td><td>@x.Rep</td><td class="num">@x.Doors</td><td class="num">@x.Leads</td><td class="num">@x.Sold</td><td class="num">@Format.Money(x.SoldAmount)</td><td class="muted">@x.Notes</td>
                                <td>@if (Model.CanEditDoors) { <form method="post" asp-page-handler="DeleteActivity" asp-route-period="@Model.Period" onsubmit="return confirm('Delete this entry?')"><input type="hidden" name="id" value="@x.Id"><button class="link-button" type="submit">Delete</button></form> }</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </section>
    }
}
else if (Model.CurrentTab == "ads")
{
    var totalSpend = Model.CountedSpend.Sum(s => s.Amount);
    var totalContract = Model.Sources.Sum(s => s.Contract);
    var g = Model.Google;
    var apiNames = string.Join(" and ", Model.ApiChannels.Select(a => a.Channel));
    var qbReady = Model.Booked?.Ready == true;
    var spendFrom = string.Join(" · ", Model.CountedSpend.GroupBy(s => SalesService.SourceLabel(s.ApiSource)).OrderByDescending(gr => gr.Sum(s => s.Amount)).Select(gr => $"{gr.Key} {Format.Money(gr.Sum(s => s.Amount))}"));
    if (Model.Error is null)
    {
        <div class="kpis">
            <div class="card kpi"><span class="kpi-label">Ad spend</span><span class="kpi-value num">@Format.Money(totalSpend)</span><span class="kpi-sub">@Model.From.ToString("MMM yyyy") – @Model.To.ToString("MMM yyyy")@(spendFrom.Length > 0 ? $" · {spendFrom}" : "")</span></div>
            <div class="card kpi"><span class="kpi-label">Jobs sold (open + last year)</span><span class="kpi-value num">@Model.Sources.Sum(s => s.Jobs)</span></div>
            <div class="card kpi"><span class="kpi-label">Contract value</span><span class="kpi-value num">@Format.Money(totalContract)</span></div>
            @if (Model.JtLeads is { } jl)
            {
                <div class="card kpi"><span class="kpi-label">New leads (JobTread)</span><span class="kpi-value num">@jl.Total.ToString("#,0")</span><span class="kpi-sub">new customer accounts · @jl.Tagged.ToString("#,0") with a lead source</span></div>
            }
        </div>
    }

    <section class="card fin-section gads">
        <div class="gads-head">
            <h2 class="section-title">Google Ads</h2>
            @if (g?.Ready == true)
            {
                <span class="chip good">From Google Ads API</span>
                <span class="muted small">@(g.Connection?.AdsCustomerName) · @AdsAccountId(g.Connection?.AdsCustomerId)</span>
                <span class="gads-refresh"><a class="refresh-button" asp-page="/Sales/Index" asp-route-tab="ads" asp-route-period="@Model.Period" asp-route-refresh="true">↻ Refresh</a>@if (GoogleClient.AdsAsOf is { } asOf) { <span class="muted small"> as of @Format.QbAsOf(asOf)</span> }</span>
            }
            else
            {
                <span class="chip warn">@(g?.ProblemKind is "not-configured" or "not-connected" ? "Not connected" : "Needs attention")</span>
            }
        </div>
        @if (g is { Ready: false })
        {
            <p class="muted">@g.Problem @if (g.ProblemKind != "not-configured") { <a href="/connections">Open Connections</a> }</p>
            <p class="muted small">Until then, Google Ads spend comes from what's booked in QuickBooks (6420 Google Advertising Lead Gen)@(qbReady ? "" : " once QuickBooks is connected, or add it by hand below").</p>
        }
        else if (g?.Report is { } report)
        {
            string fromMonth = Model.From.ToString("yyyy-MM"), toMonth = Model.To.ToString("yyyy-MM");
            var inPeriod = Model.GoogleMonths.Where(m => string.CompareOrdinal(m.Month, fromMonth) >= 0 && string.CompareOrdinal(m.Month, toMonth) <= 0).ToList();
            var pCost = inPeriod.Sum(m => m.Cost); var pClicks = inPeriod.Sum(m => m.Clicks); var pLeads = inPeriod.Sum(m => m.Conversions);
            <div class="gads-kpis">
                <div><span class="kpi-label">Spend</span><b class="num">@Format.Money(pCost)</b></div>
                <div><span class="kpi-label">Clicks</span><b class="num">@pClicks.ToString("#,0")</b></div>
                <div><span class="kpi-label">Leads</span><b class="num">@Format.Number(pLeads)</b></div>
                <div><span class="kpi-label">Cost per lead</span><b class="num">@(pLeads > 0 ? Format.Money(pCost / pLeads) : "—")</b></div>
                @if (report.PhoneCallsAvailable) { <div><span class="kpi-label">Calls from ads</span><b class="num">@inPeriod.Sum(m => m.PhoneCalls ?? 0).ToString("#,0")</b></div> }
            </div>
            <p class="muted small">@Model.From.ToString("MMM yyyy") – @Model.To.ToString("MMM yyyy") (whole months). Leads = Google Ads conversions: whatever the account counts as one (calls from ads, form fills). Read only: the dashboard never changes ads.</p>

            <h3 class="gads-sub">By month <span class="muted small">last 12 months</span></h3>
            <div class="table-wrap">
                <table class="data">
                    <thead><tr><th>Month</th><th class="num">Spend</th><th class="num">Impr.</th><th class="num">Clicks</th><th class="num">Leads</th>@if (report.PhoneCallsAvailable) { <th class="num">Calls</th> }<th class="num">Cost / lead</th></tr></thead>
                    <tbody>
                        @foreach (var m in Enumerable.Reverse(Model.GoogleMonths))
                        {
                            var inRange = string.CompareOrdinal(m.Month, fromMonth) >= 0 && string.CompareOrdinal(m.Month, toMonth) <= 0;
                            <tr class="@(inRange ? "in-period" : "")"><td>@MonthLabel(m.Month)</td><td class="num">@Format.Money(m.Cost)</td><td class="num">@m.Impressions.ToString("#,0")</td><td class="num">@m.Clicks.ToString("#,0")</td><td class="num">@Format.Number(m.Conversions)</td>@if (report.PhoneCallsAvailable) { <td class="num">@m.PhoneCalls?.ToString("#,0")</td> }<td class="num">@Format.Money(m.CostPerLead)</td></tr>
                        }
                        @{ var tc = Model.GoogleMonths.Sum(m => m.Cost); var tl = Model.GoogleMonths.Sum(m => m.Conversions); }
                        <tr class="total"><td>12 months</td><td class="num">@Format.Money(tc)</td><td class="num">@Model.GoogleMonths.Sum(m => m.Impressions).ToString("#,0")</td><td class="num">@Model.GoogleMonths.Sum(m => m.Clicks).ToString("#,0")</td><td class="num">@Format.Number(tl)</td>@if (report.PhoneCallsAvailable) { <td class="num">@Model.GoogleMonths.Sum(m => m.PhoneCalls ?? 0).ToString("#,0")</td> }<td class="num">@(tl > 0 ? Format.Money(tc / tl) : "—")</td></tr>
                    </tbody>
                </table>
            </div>

            <h3 class="gads-sub">By campaign <span class="muted small">@Model.From.ToString("MMM yyyy") – @Model.To.ToString("MMM yyyy")</span></h3>
            <div class="table-wrap">
                <table class="data campaigns">
                    <thead><tr><th>Campaign</th><th>Status</th><th class="num">Spend</th><th class="num">Impr.</th><th class="num">Clicks</th><th class="num">CTR</th><th class="num">Leads</th>@if (report.PhoneCallsAvailable) { <th class="num">Calls</th> }<th class="num">Cost / lead</th></tr></thead>
                    <tbody>
                        @foreach (var c in Model.GoogleCampaigns)
                        {
                            <tr><td>@c.Name</td><td><span class="chip @(c.Status == "ENABLED" ? "good" : "")">@GoogleAdsService.StatusLabel(c.Status)</span></td><td class="num">@Format.Money(c.Cost)</td><td class="num">@c.Impressions.ToString("#,0")</td><td class="num">@c.Clicks.ToString("#,0")</td><td class="num">@(c.ClickRate is { } ctr ? ctr.ToString("0.0") + "%" : "—")</td><td class="num">@Format.Number(c.Conversions)</td>@if (report.PhoneCallsAvailable) { <td class="num">@c.PhoneCalls?.ToString("#,0")</td> }<td class="num">@Format.Money(c.CostPerLead)</td></tr>
                        }
                        @if (Model.GoogleCampaigns.Count == 0) { <tr><td colspan="9" class="muted">No Google Ads spend in this period.</td></tr> }
                    </tbody>
                </table>
            </div>
        }
    </section>

    <partial name="_MetaAds" model="Model.Meta" />

    @if (Model.Error is null)
    {
    <section class="card fin-section">
        <h2 class="section-title">Ads → revenue by lead source</h2>
        <p class="muted small">Jobs sold (open + last year) by the customer's <b>Lead Source</b> in JobTread. The website form sets it from the ad click (Google Ad, Meta, NextDoor), otherwise it's set by hand. Google Ad and Google count as Google Ads, Meta as Facebook/Instagram. <b>Spend</b>, per channel and month: @(Model.ApiChannels.Count > 0 ? $"{string.Join("; ", Model.ApiChannels.Select(a => $"{a.Channel} from the {(a.Api == "Meta" ? "Meta Marketing" : a.Api)} API"))}; " : "")@(qbReady ? "otherwise what's booked in QuickBooks (see Platform vs QuickBooks below); spend not in QuickBooks can be added by hand." : "other channels as entered by hand.") Platform leads are what the ad platform reports. <b>JT leads</b> are new JobTread customer accounts created @Model.From.ToString("MMM yyyy") – @Model.To.ToString("MMM yyyy") with that Lead Source. <b>Close rate</b> is how many of those new accounts already have a sold job.</p>
        @if (Model.JtLeads is { Untagged: > 0 } untagged)
        {
            <p class="muted small">@untagged.Untagged.ToString("#,0") of @untagged.Total.ToString("#,0") new customer accounts in this period have no Lead Source in JobTread, so they aren't in any row. Sold jobs whose customer has no Lead Source are listed at the bottom by "How bid came in".</p>
        }
        @if (Model.ReplacedSpend.Count > 0)
        {
            var rs = Model.ReplacedSpend.Values.ToList();
            <p class="notice-inline warn small">@rs.Count hand-entered @(rs.Count == 1 ? "row isn't" : "rows aren't") counted (@string.Join(", ", rs.OrderBy(r => r.Row.Month).Select(r => $"{r.Row.Channel} {r.Row.Month}"))): @(rs.All(r => r.ApiName == QuickBooksAdSpendService.SourceName) ? "QuickBooks has spend booked for that channel and month" : "an API or QuickBooks has that channel and month"), so that figure is used instead, never both (see "Spend entered").</p>
        }
        <div class="table-wrap">
            <table class="data">
                <thead><tr><th>Lead source</th><th class="num">Jobs</th><th class="num">Contract</th><th class="num">Spend</th><th class="num" title="Leads reported by the ad platform">Platform leads</th><th class="num" title="New JobTread customer accounts in the period with this Lead Source">JT leads</th><th class="num">Cost / JT lead</th><th class="num" title="New accounts in the period that have a sold job ÷ JT leads">Close rate</th><th class="num" title="Contract per $1 spent">Contract / $1</th></tr></thead>
                <tbody>
                    @foreach (var s in Model.Sources)
                    {
                        var isQb = s.ApiSource == QuickBooksAdSpendService.SourceName;
                        <tr class="@(s.NoLeadSource ? "muted" : "")"><td>@s.Source@if (s.FromApi) { <span class="chip @(isQb ? "" : "good") api-chip" title="@(isQb ? "Spend booked in QuickBooks" : $"Spend and leads from the {s.ApiSource} API")">@(isQb ? "QB" : "API")</span> }</td><td class="num">@s.Jobs</td><td class="num">@Format.Money(s.Contract)</td><td class="num">@(s.Spend > 0 ? Format.Money(s.Spend) : "—")</td><td class="num">@(s.Leads is { } l ? Format.Number(l) : "—")</td><td class="num">@(s.JtLeads?.ToString("#,0") ?? "—")</td><td class="num">@(s.CostPerJtLead is { } cpl ? Format.Money(cpl) : "—")</td><td class="num" title="@(s.CloseRate is not null ? $"{s.WonLeads} of {s.JtLeads} new accounts have a sold job" : "")">@(s.CloseRate is { } cr ? Format.Percent(100m * cr) : "—")</td><td class="num">@(s.Spend > 0 ? (s.Contract / s.Spend).ToString("$0.00") : "—")</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </section>

    <section class="card fin-section" id="reconcile">
        <div class="gads-head">
            <h2 class="section-title">Platform vs QuickBooks</h2>
            @if (qbReady)
            {
                <span class="chip good">From QuickBooks</span>
                <span class="gads-refresh"><a class="refresh-button" asp-page="/Sales/Index" asp-route-tab="ads" asp-route-period="@Model.Period" asp-route-qbrefresh="true" asp-fragment="reconcile">↻ Refresh</a>@if (PurpleDashboard.Integrations.QuickBooks.QuickBooksClient.DataAsOf is { } qbAsOf) { <span class="muted small"> QuickBooks as of @Format.QbAsOf(qbAsOf)</span> }</span>
            }
            else
            {
                <span class="chip warn">@(Model.Booked?.State is BookedAdSpendState.Error ? "Needs attention" : "Not connected")</span>
            }
        </div>
        @if (!qbReady)
        {
            <p class="muted">@Model.Booked?.Problem @if (Model.Booked?.State is not BookedAdSpendState.NotSetUp) { <a href="/connections">Open Connections</a> }</p>
        }
        else
        {
            var booked = Model.Booked!;
            var flagged = Model.Reconcile.Count(r => r.Flag);
            <p class="muted small">Ad spend booked in QuickBooks under 6400 Marketing &amp; Sales (@(booked.Accounts.Count > 0 ? string.Join(", ", booked.Accounts) : "no ad accounts found")), per channel and month, next to what the ad platform reports. 6410 is split by vendor (Facebook/Meta, Nextdoor, Yelp…; anything else is "Other advertising"). <b>Counted</b> is the figure used above: the platform when it's connected, else QuickBooks, else entered by hand. Difference = platform − QuickBooks.</p>
            @if (booked.Problem is not null) { <p class="notice-inline warn small">@booked.Problem</p> }
            @if (flagged > 0)
            {
                <p class="notice-inline warn small">@flagged @(flagged == 1 ? "month differs" : "months differ") by more than @Format.Money(SalesService.ReconcileMinDollars) and @((SalesService.ReconcileMinShare * 100).ToString("0"))% between the platform and QuickBooks (flagged below).</p>
            }
            @if (Model.ReplacedBooked.Count > 0)
            {
                <p class="muted small">QuickBooks figures for @string.Join(" and ", Model.ReplacedBooked.Select(r => r.Line.Channel).Distinct()) (@Format.Money(Model.ReplacedBooked.Sum(r => r.Line.Amount)) in this period) are shown for checking only; the platform's figure is counted, never both.</p>
            }
            @if (Model.NonAdSpend.Count > 0)
            {
                <p class="muted small">@string.Join(" and ", Model.NonAdSpend.Select(l => l.Channel).Distinct(StringComparer.OrdinalIgnoreCase)) (@Format.Money(Model.NonAdSpend.Sum(l => l.Amount)) in this period) @(Model.NonAdSpend.Select(l => l.Channel).Distinct(StringComparer.OrdinalIgnoreCase).Count() == 1 ? "is" : "are") marketing but not ad spend, so @(Model.NonAdSpend.Select(l => l.Channel).Distinct(StringComparer.OrdinalIgnoreCase).Count() == 1 ? "it isn't" : "they aren't") in the Ad spend total or the lead-source table.</p>
            }
            <div class="table-wrap">
                <table class="data reconcile">
                    <thead><tr><th>Month</th><th>Channel</th><th class="num">Platform reported</th><th class="num">Booked in QuickBooks</th><th class="num">Difference</th><th class="num">Counted</th></tr></thead>
                    <tbody>
                        @foreach (var r in Model.Reconcile)
                        {
                            <tr class="@(r.Flag ? "flagged" : "")">
                                <td>@MonthLabel(r.Month)@if (r.Month == LocalClock.Today.ToString("yyyy-MM")) { <span class="muted small recon-src">so far</span> }</td>
                                <td>@r.Channel</td>
                                <td class="num">@(r.PlatformAmount is { } pa ? Format.Money(pa) : "—")@if (r.Platform is not null) { <span class="muted small recon-src">@r.Platform</span> } else { <span class="muted small recon-src">@(string.Equals(r.Channel, Model.GoogleChannel, StringComparison.OrdinalIgnoreCase) || string.Equals(r.Channel, MetaAdsService.Channel, StringComparison.OrdinalIgnoreCase) ? "not connected" : "no API")</span> }</td>
                                <td class="num">@(r.Booked is { } b ? Format.Money(b) : "—")</td>
                                <td class="num">@if (r.Difference is { } d) { <span class="@(r.Flag ? "chip warn" : "")">@(d > 0 ? "+" : "")@Format.Money(d)</span> } else { <span>—</span> }</td>
                                <td class="num">@if (r.NotAdSpend) { <span class="muted">—</span><span class="muted small recon-src">not ad spend</span> } else { @Format.Money(r.Counted)<span class="muted small recon-src">@r.CountedFrom</span> }</td>
                            </tr>
                        }
                        @if (Model.Reconcile.Count == 0) { <tr><td colspan="6" class="muted">No ad spend booked in QuickBooks or reported by a platform in this period.</td></tr> }
                    </tbody>
                </table>
            </div>
            <details class="recon-more">
                <summary>Why platform and QuickBooks differ</summary>
                <ul class="muted small">
                    <li><b>Billing timing.</b> Google and Meta charge the card when spend reaches a threshold or at month end, so a charge dated the 1st–3rd is often last month's clicks. It shows as one month high and the next low; over a few months they even out.</li>
                    <li><b>Card charge booked to the wrong account.</b> A Google charge categorized under 6410 (or Meta under 6420, or either under office expenses or a general credit card account). Google charges in 6410 are counted as Google Ads here; ones in non-ad accounts aren't seen at all.</li>
                    <li><b>Not booked yet.</b> Bank-feed transactions still waiting to be categorized in QuickBooks, especially this month (marked "so far").</li>
                    <li><b>Credits and refunds.</b> Platform credits (invalid clicks, promo credits) lower QuickBooks but not always the platform's reported spend.</li>
                    <li><b>Tax and fees.</b> Sales tax or card fees on ad charges make QuickBooks a little higher.</li>
                </ul>
            </details>
            var inPeriod = booked.Lines.Where(l => string.CompareOrdinal(l.Month, Model.From.ToString("yyyy-MM")) >= 0 && string.CompareOrdinal(l.Month, Model.To.ToString("yyyy-MM")) <= 0).OrderByDescending(l => l.Date).ToList();
            @if (inPeriod.Count > 0)
            {
                <details class="recon-more">
                    <summary>QuickBooks lines in this period (@inPeriod.Count)</summary>
                    <div class="table-wrap">
                        <table class="data">
                            <thead><tr><th>Date</th><th>Account</th><th>Vendor</th><th>Channel</th><th class="num">Amount</th></tr></thead>
                            <tbody>
                                @foreach (var l in inPeriod)
                                {
                                    <tr><td>@Format.Date(l.Date)</td><td>@l.Account</td><td>@(l.Vendor ?? l.Memo ?? "—")</td><td>@l.Channel</td><td class="num">@Format.Money(l.Amount)</td></tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </details>
            }
        }
    </section>

    @if (Model.CanEditAds)
    {
        <section class="card fin-section">
            <details class="recon-more spend-add" open="@(!qbReady && Model.ApiChannels.Count == 0)">
                <summary>Add spend not in QuickBooks</summary>
                <p class="muted small">Only for spend that isn't booked in QuickBooks@(Model.ApiChannels.Count > 0 ? $" and doesn't come from an API ({apiNames})" : "") (e.g. paid on a personal card). A month and channel QuickBooks already has isn't counted twice: QuickBooks wins.</p>
                <form method="post" asp-page-handler="Spend" asp-route-period="@Model.Period" class="inline-form wrap">
                    <label class="field"><span>Month</span><input type="month" name="month" value="@LocalClock.Today.ToString("yyyy-MM")" required></label>
                    <label class="field"><span>Channel</span><input name="channel" list="channels" required placeholder="e.g. Nextdoor"></label>
                    <datalist id="channels">@foreach (var s in Model.Sources.Where(s => !s.NoLeadSource)) { <option value="@s.Source"></option> }</datalist>
                    <label class="field"><span>Amount</span><input name="amount" inputmode="decimal" required style="width:120px"></label>
                    <label class="field"><span>Leads (optional)</span><input type="number" name="leads" min="0" style="width:110px"></label>
                    <button class="button" type="submit">Save</button>
                </form>
                <p class="muted small">Use the channel names in the table above (JobTread's Lead Source; "Nextdoor", "Google Ads", "Facebook/Instagram" and their usual spellings line up automatically). Saving the same month and channel again replaces it.</p>
            </details>
        </section>
    }

    @if (Model.Spend.Count > 0)
    {
        <section class="card fin-section">
            <h2 class="section-title">Spend entered</h2>
            <div class="table-wrap">
                <table class="data">
                    <thead><tr><th>Month</th><th>Channel</th><th class="num">Amount</th><th class="num">Leads</th><th></th></tr></thead>
                    <tbody>
                        @foreach (var s in Model.Spend)
                        {
                            var r = Model.ReplacedSpend.GetValueOrDefault(s.Id);
                            var by = r is null ? "" : r.ApiName == QuickBooksAdSpendService.SourceName ? "QuickBooks" : "API";
                            <tr class="@(r is not null ? "replaced" : "")"><td>@s.Month</td><td>@s.Channel@if (r is not null) { <span class="chip warn api-chip" title="@SalesService.SourceLabel(r.ApiName) for @s.Month: @Format.Money(r.ApiAmount)">Not counted · @by: @Format.Money(r.ApiAmount)</span> }</td><td class="num">@Format.Money(s.Amount)</td><td class="num">@(s.Leads?.ToString() ?? "—")</td>
                                <td>@if (Model.CanEditAds) { <form method="post" asp-page-handler="DeleteSpend" asp-route-period="@Model.Period" onsubmit="return confirm('Delete?')"><input type="hidden" name="id" value="@s.Id"><button class="link-button" type="submit">Delete</button></form> }</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </section>
    }
    }
}

@functions {
    static string IndexModelPct(decimal part, decimal whole) => whole == 0 ? "—" : Format.Percent(100m * part / whole);
    static string MonthLabel(string month) => DateOnly.TryParseExact(month + "-01", "yyyy-MM-dd", out var d) ? d.ToString("MMM yyyy", System.Globalization.CultureInfo.GetCultureInfo("en-US")) : month;
    static string AdsAccountId(string? id) => id is null ? "" : AdsAccount.FormatId(id);
}

@section Scripts {
    <script src="~/js/site.js" asp-append-version="true"></script>
}

            <div class="card kpi"><span class="kpi-label">Cost per lead</span><span class="kpi-value num">@(tot.CostPerLead is { } cpl ? Format.Money(cpl) : "—")</span><span class="kpi-sub">spend ÷ JobTread leads</span></div>

@page "/sales"
@model PurpleDashboard.Pages.Sales.IndexModel
@using PurpleDashboard.Infrastructure
@using PurpleDashboard.Integrations.JobTread
@using PurpleDashboard.Modules.Sales
@using PurpleDashboard.Integrations.Google

<div class="module-head">
    <div class="pills" role="tablist" aria-label="Sales sections">
        @foreach (var (key, label) in Model.Tabs)
        {
            <a class="pill@(Model.CurrentTab == key ? " active" : "")" asp-page="/Sales/Index" asp-route-tab="@(key == "commissions" ? null : key)">@label</a>
        }
    </div>
    @if (Model.CurrentTab != "commissions")
    {
        <form class="filters" method="get" data-autosubmit>
            <input type="hidden" name="tab" value="@Model.CurrentTab">
            <select name="period" aria-label="Period">
                <option value="30" selected="@(Model.Period == "30")">Last 30 days</option>
                <option value="" selected="@(Model.Period is null or "90")">Last 90 days</option>
                <option value="ytd" selected="@(Model.Period == "ytd")">Year to date</option>
                @if (Model.CurrentTab == "ads") { <option value="12" selected="@(Model.Period == "12")">Last 12 months</option> }
            </select>
        </form>
    }
</div>

@if (Model.Message is not null) { <div class="card notice"><p>@Model.Message</p></div> }
@if (!Model.CanEdit) { <div class="card notice warn"><p>The dashboard database isn't available, so nothing can be saved right now.</p></div> }
@if (Model.Error is not null) { <div class="card notice warn"><strong>Couldn't load.</strong><p>@Model.Error</p></div> }

@if (Model.CurrentTab == "commissions" && Model.Error is null)
{
    <p class="list-meta muted">Salesperson comes from each job in JobTread. @(Model.CanEditCommissions ? "Set each person's rate below; " : "")"collected" pays as the customer pays (invoices minus unpaid, before retention).</p>

    <section class="card fin-section">
        <h2 class="section-title">Salespeople</h2>
        <div class="table-wrap">
            <table class="data">
                <thead><tr><th>Person</th><th>Rate</th><th class="num">Jobs</th><th class="num">Earned</th><th class="num">Paid</th><th class="num">Owed</th></tr></thead>
                <tbody>
                    @foreach (var p in Model.People)
                    {
                        <tr>
                            <td>
                                @if (!Model.CanEditCommissions) { <b>@p.Person</b> } else {
                                <details class="acct-list">
                                    <summary><b>@p.Person</b></summary>
                                    <form method="post" asp-page-handler="Rule" class="inline-form">
                                        <input type="hidden" name="person" value="@p.Person">
                                        <input name="percent" inputmode="decimal" value="@(p.Rule?.Percent.ToString("0.##"))" placeholder="%" aria-label="Commission percent" style="width:70px" required>
                                        <select name="basis" aria-label="Commission based on">
                                            @foreach (var b in SalesService.Bases) { <option value="@b" selected="@((p.Rule?.Basis ?? "collected") == b)">% @SalesService.BasisLabel(b)</option> }
                                        </select>
                                        <input name="notes" value="@p.Rule?.Notes" placeholder="Notes (optional)" aria-label="Notes">
                                        <button class="button secondary" type="submit">Save</button>
                                    </form>
                                </details>
                                }
                            </td>
                            <td class="@(p.Rule is null ? "neg" : "")">@IndexModel.Rate(p.Rule)</td>
                            <td class="num">@p.Jobs</td>
                            <td class="num">@Format.Money(p.Earned)</td>
                            <td class="num">@Format.Money(p.Paid)</td>
                            <td class="num"><b>@Format.Money(p.Owed)</b></td>
                        </tr>
                    }
                    <tr class="total"><td>Total</td><td></td><td class="num">@Model.People.Sum(p => p.Jobs)</td><td class="num">@Format.Money(Model.People.Sum(p => p.Earned))</td><td class="num">@Format.Money(Model.People.Sum(p => p.Paid))</td><td class="num">@Format.Money(Model.People.Sum(p => p.Owed))</td></tr>
                </tbody>
            </table>
        </div>
    </section>

    <div class="pills">
        <a class="pill@(Model.Show != "all" ? " active" : "")" asp-page="/Sales/Index">Owed</a>
        <a class="pill@(Model.Show == "all" ? " active" : "")" asp-page="/Sales/Index" asp-route-show="all">All jobs</a>
    </div>
    <div class="job-list" style="margin-top:10px">
        @if (Model.Show != "all" && Model.JobsWithoutRate > 0)
        {
            <p class="list-meta muted">@Model.JobsWithoutRate job@(Model.JobsWithoutRate == 1 ? "" : "s") can't owe anything until the salesperson has a commission rate: set rates in the table above, or see <a asp-page="/Sales/Index" asp-route-show="all">All jobs</a>.</p>
        }
        @if (!Model.ShownCommissions.Any()) { <div class="card empty-state"><p class="muted">Nothing owed right now.</p></div> }
        @foreach (var c in Model.ShownCommissions)
        {
            var jobPayments = Model.Payments.Where(p => p.JobId == c.JobId).OrderByDescending(p => p.PaidOn).ThenByDescending(p => p.Id).ToList();
            <details class="job card emp" id="comm-@c.JobId" open="@(Model.Open == c.JobId)">
                <summary class="emp-row with-chip">
                    <span class="chip">@c.Person.Split(' ')[0]</span>
                    <div class="job-main">
                        <div class="job-title">#@c.Number @c.JobName</div>
                        <div class="job-sub muted">@c.Stage · contract @Format.Money(c.Contract) · collected @Format.Money(c.Collected)</div>
                    </div>
                    <span class="emp-rates num"><span>Earned @Format.Money(c.Earned)</span><span class="muted">Paid @Format.Money(c.Paid)</span></span>
                    <span class="emp-hours num"><b>@(c.Rule is null ? "set rate" : Format.Money(c.Owed))</b></span>
                    <span class="chevron" aria-hidden="true"></span>
                </summary>
                <div class="job-detail bonus-detail">
                    <p class="muted small">@c.Person: @IndexModel.Rate(c.Rule) · job profit @Format.Money(c.Profit) · <a href="@JobTreadIds.JobUrl(c.JobId)" target="_blank" rel="noopener">JobTread ↗</a></p>
                    @if (Model.CanEditCommissions)
                    {
                        <form method="post" asp-page-handler="Pay" asp-route-show="@Model.Show" class="inline-form">
                            <input type="hidden" name="jobId" value="@c.JobId"><input type="hidden" name="jobName" value="@c.JobName"><input type="hidden" name="person" value="@c.Person">
                            <input name="amount" inputmode="decimal" value="@(c.Owed > 0 ? c.Owed.ToString("0.00") : "")" placeholder="Amount" aria-label="Amount paid" style="width:110px" required>
                            <input type="date" name="paidOn" value="@LocalClock.Today.ToString("yyyy-MM-dd")" aria-label="Paid on">
                            <input name="note" placeholder="Note (e.g. check #, payroll date)" aria-label="Note">
                            <button class="button" type="submit">Record payment</button>
                        </form>
                    }
                    @if (Model.Open == c.JobId && Model.Message is not null) { <p class="notice-inline good">@Model.Message</p> }
                    @if (jobPayments.Count > 0)
                    {
                        <table class="data compact" style="margin-top:8px">
                            <thead><tr><th>Paid</th><th class="num">Amount</th><th>Note</th><th></th></tr></thead>
                            <tbody>
                                @foreach (var p in jobPayments)
                                {
                                    <tr>
                                        <td>@Format.Date(p.PaidOn)</td><td class="num">@Format.Money(p.Amount)</td><td class="muted">@p.Note</td>
                                        <td>@if (Model.CanEditCommissions) { <form method="post" asp-page-handler="DeletePayment" asp-route-show="@Model.Show" onsubmit="return confirm('Delete this payment record?')"><input type="hidden" name="id" value="@p.Id"><input type="hidden" name="jobId" value="@c.JobId"><button class="link-button" type="submit">Delete</button></form> }</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                </div>
            </details>
        }
    </div>

    @if (Model.Payments.Count > 0)
    {
        <section class="card fin-section" style="margin-top:12px">
            <h2 class="section-title">Recent payments</h2>
            <div class="table-wrap">
                <table class="data">
                    <thead><tr><th>Paid</th><th>Person</th><th>Job</th><th class="num">Amount</th><th>Note</th><th></th></tr></thead>
                    <tbody>
                        @foreach (var p in Model.Payments)
                        {
                            <tr>
                                <td>@Format.Date(p.PaidOn)</td><td>@p.Person</td><td>@p.JobName</td><td class="num">@Format.Money(p.Amount)</td><td class="muted">@p.Note</td>
                                <td>@if (Model.CanEditCommissions) { <form method="post" asp-page-handler="DeletePayment" asp-route-show="@Model.Show" onsubmit="return confirm('Delete this payment record?')"><input type="hidden" name="id" value="@p.Id"><button class="link-button" type="submit">Delete</button></form> }</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </section>
    }
}
else if (Model.CurrentTab == "doors" && Model.Error is null)
{
    var a = Model.Activity;
    <div class="kpis">
        <div class="card kpi"><span class="kpi-label">Doors</span><span class="kpi-value num">@a.Sum(x => x.Doors).ToString("#,0")</span></div>
        <div class="card kpi"><span class="kpi-label">Leads</span><span class="kpi-value num">@a.Sum(x => x.Leads)</span><span class="kpi-sub num">@IndexModelPct(a.Sum(x => x.Leads), a.Sum(x => x.Doors)) of doors</span></div>
        <div class="card kpi"><span class="kpi-label">Sold</span><span class="kpi-value num">@a.Sum(x => x.Sold)</span><span class="kpi-sub num">@IndexModelPct(a.Sum(x => x.Sold), a.Sum(x => x.Leads)) of leads</span></div>
        <div class="card kpi"><span class="kpi-label">Sold $</span><span class="kpi-value num">@Format.Money(a.Sum(x => x.SoldAmount))</span></div>
    </div>

    @if (Model.CanEditDoors)
    {
        <section class="card fin-section">
            <h2 class="section-title">Log activity</h2>
            <form method="post" asp-page-handler="Activity" asp-route-period="@Model.Period" class="inline-form wrap">
                <label class="field"><span>Date</span><input type="date" name="date" value="@LocalClock.Today.ToString("yyyy-MM-dd")"></label>
                <label class="field"><span>Rep</span><input name="rep" required list="reps"></label>
                <datalist id="reps">@foreach (var r in a.Select(x => x.Rep).Distinct()) { <option value="@r"></option> }</datalist>
                <label class="field"><span>Doors</span><input type="number" name="doors" min="0" value="0" style="width:90px"></label>
                <label class="field"><span>Leads</span><input type="number" name="leads" min="0" value="0" style="width:90px"></label>
                <label class="field"><span>Sold</span><input type="number" name="sold" min="0" value="0" style="width:90px"></label>
                <label class="field"><span>Sold $</span><input name="soldAmount" inputmode="decimal" style="width:110px"></label>
                <label class="field grow"><span>Notes</span><input name="notes"></label>
                <button class="button" type="submit">Log</button>
            </form>
        </section>
    }

    <section class="card fin-section">
        <h2 class="section-title">By rep</h2>
        <div class="table-wrap">
            <table class="data">
                <thead><tr><th>Rep</th><th class="num">Days</th><th class="num">Doors</th><th class="num">Leads</th><th class="num">Sold</th><th class="num">Sold $</th></tr></thead>
                <tbody>
                    @foreach (var g in a.GroupBy(x => x.Rep).OrderByDescending(g => g.Sum(x => x.SoldAmount)))
                    {
                        <tr><td>@g.Key</td><td class="num">@g.Select(x => x.Date).Distinct().Count()</td><td class="num">@g.Sum(x => x.Doors)</td><td class="num">@g.Sum(x => x.Leads)</td><td class="num">@g.Sum(x => x.Sold)</td><td class="num">@Format.Money(g.Sum(x => x.SoldAmount))</td></tr>
                    }
                    @if (a.Count == 0) { <tr><td colspan="6" class="muted">Nothing logged in this period.</td></tr> }
                </tbody>
            </table>
        </div>
    </section>

    @if (a.Count > 0)
    {
        <section class="card fin-section">
            <h2 class="section-title">Log</h2>
            <div class="table-wrap">
                <table class="data">
                    <thead><tr><th>Date</th><th>Rep</th><th class="num">Doors</th><th class="num">Leads</th><th class="num">Sold</th><th class="num">Sold $</th><th>Notes</th><th></th></tr></thead>
                    <tbody>
                        @foreach (var x in a)
                        {
                            <tr><td>@Format.Date(x.Date)</td><td>@x.Rep</td><td class="num">@x.Doors</td><td class="num">@x.Leads</td><td class="num">@x.Sold</td><td class="num">@Format.Money(x.SoldAmount)</td><td class="muted">@x.Notes</td>
                                <td>@if (Model.CanEditDoors) { <form method="post" asp-page-handler="DeleteActivity" asp-route-period="@Model.Period" onsubmit="return confirm('Delete this entry?')"><input type="hidden" name="id" value="@x.Id"><button class="link-button" type="submit">Delete</button></form> }</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </section>
    }
}
else if (Model.CurrentTab == "ads")
{
    var totalSpend = Model.CountedSpend.Sum(s => s.Amount);
    var totalContract = Model.Sources.Sum(s => s.Contract);
    var g = Model.Google;
    var apiNames = string.Join(" and ", Model.ApiChannels.Select(a => a.Channel));
    if (Model.Error is null)
    {
        <div class="kpis">
            <div class="card kpi"><span class="kpi-label">Ad spend</span><span class="kpi-value num">@Format.Money(totalSpend)</span><span class="kpi-sub">@Model.From.ToString("MMM yyyy") – @Model.To.ToString("MMM yyyy")@(Model.ApiChannels.Count > 0 ? $" · {apiNames} from the API" : "")</span></div>
            <div class="card kpi"><span class="kpi-label">Jobs sold (open + last year)</span><span class="kpi-value num">@Model.Sources.Sum(s => s.Jobs)</span></div>
            <div class="card kpi"><span class="kpi-label">Contract value</span><span class="kpi-value num">@Format.Money(totalContract)</span></div>
            @if (Model.JtLeads is { } jl)
            {
                <div class="card kpi"><span class="kpi-label">New leads (JobTread)</span><span class="kpi-value num">@jl.Total.ToString("#,0")</span><span class="kpi-sub">new customer accounts · @jl.Tagged.ToString("#,0") with a lead source</span></div>
            }
        </div>
    }

    <section class="card fin-section gads">
        <div class="gads-head">
            <h2 class="section-title">Google Ads</h2>
            @if (g?.Ready == true)
            {
                <span class="chip good">From Google Ads API</span>
                <span class="muted small">@(g.Connection?.AdsCustomerName) · @AdsAccountId(g.Connection?.AdsCustomerId)</span>
                <span class="gads-refresh"><a class="refresh-button" asp-page="/Sales/Index" asp-route-tab="ads" asp-route-period="@Model.Period" asp-route-refresh="true">↻ Refresh</a>@if (GoogleClient.AdsAsOf is { } asOf) { <span class="muted small"> as of @Format.QbAsOf(asOf)</span> }</span>
            }
            else
            {
                <span class="chip warn">@(g?.ProblemKind is "not-configured" or "not-connected" ? "Not connected" : "Needs attention")</span>
            }
        </div>
        @if (g is { Ready: false })
        {
            <p class="muted">@g.Problem @if (g.ProblemKind != "not-configured") { <a href="/connections">Open Connections</a> }</p>
            <p class="muted small">Until then, enter Google Ads spend by hand below like any other channel.</p>
        }
        else if (g?.Report is { } report)
        {
            string fromMonth = Model.From.ToString("yyyy-MM"), toMonth = Model.To.ToString("yyyy-MM");
            var inPeriod = Model.GoogleMonths.Where(m => string.CompareOrdinal(m.Month, fromMonth) >= 0 && string.CompareOrdinal(m.Month, toMonth) <= 0).ToList();
            var pCost = inPeriod.Sum(m => m.Cost); var pClicks = inPeriod.Sum(m => m.Clicks); var pLeads = inPeriod.Sum(m => m.Conversions);
            <div class="gads-kpis">
                <div><span class="kpi-label">Spend</span><b class="num">@Format.Money(pCost)</b></div>
                <div><span class="kpi-label">Clicks</span><b class="num">@pClicks.ToString("#,0")</b></div>
                <div><span class="kpi-label">Leads</span><b class="num">@Format.Number(pLeads)</b></div>
                <div><span class="kpi-label">Cost per lead</span><b class="num">@(pLeads > 0 ? Format.Money(pCost / pLeads) : "—")</b></div>
                @if (report.PhoneCallsAvailable) { <div><span class="kpi-label">Calls from ads</span><b class="num">@inPeriod.Sum(m => m.PhoneCalls ?? 0).ToString("#,0")</b></div> }
            </div>
            <p class="muted small">@Model.From.ToString("MMM yyyy") – @Model.To.ToString("MMM yyyy") (whole months). Leads = Google Ads conversions: whatever the account counts as one (calls from ads, form fills). Read only: the dashboard never changes ads.</p>

            <h3 class="gads-sub">By month <span class="muted small">last 12 months</span></h3>
            <div class="table-wrap">
                <table class="data">
                    <thead><tr><th>Month</th><th class="num">Spend</th><th class="num">Impr.</th><th class="num">Clicks</th><th class="num">Leads</th>@if (report.PhoneCallsAvailable) { <th class="num">Calls</th> }<th class="num">Cost / lead</th></tr></thead>
                    <tbody>
                        @foreach (var m in Enumerable.Reverse(Model.GoogleMonths))
                        {
                            var inRange = string.CompareOrdinal(m.Month, fromMonth) >= 0 && string.CompareOrdinal(m.Month, toMonth) <= 0;
                            <tr class="@(inRange ? "in-period" : "")"><td>@MonthLabel(m.Month)</td><td class="num">@Format.Money(m.Cost)</td><td class="num">@m.Impressions.ToString("#,0")</td><td class="num">@m.Clicks.ToString("#,0")</td><td class="num">@Format.Number(m.Conversions)</td>@if (report.PhoneCallsAvailable) { <td class="num">@m.PhoneCalls?.ToString("#,0")</td> }<td class="num">@Format.Money(m.CostPerLead)</td></tr>
                        }
                        @{ var tc = Model.GoogleMonths.Sum(m => m.Cost); var tl = Model.GoogleMonths.Sum(m => m.Conversions); }
                        <tr class="total"><td>12 months</td><td class="num">@Format.Money(tc)</td><td class="num">@Model.GoogleMonths.Sum(m => m.Impressions).ToString("#,0")</td><td class="num">@Model.GoogleMonths.Sum(m => m.Clicks).ToString("#,0")</td><td class="num">@Format.Number(tl)</td>@if (report.PhoneCallsAvailable) { <td class="num">@Model.GoogleMonths.Sum(m => m.PhoneCalls ?? 0).ToString("#,0")</td> }<td class="num">@(tl > 0 ? Format.Money(tc / tl) : "—")</td></tr>
                    </tbody>
                </table>
            </div>

            <h3 class="gads-sub">By campaign <span class="muted small">@Model.From.ToString("MMM yyyy") – @Model.To.ToString("MMM yyyy")</span></h3>
            <div class="table-wrap">
                <table class="data campaigns">
                    <thead><tr><th>Campaign</th><th>Status</th><th class="num">Spend</th><th class="num">Impr.</th><th class="num">Clicks</th><th class="num">CTR</th><th class="num">Leads</th>@if (report.PhoneCallsAvailable) { <th class="num">Calls</th> }<th class="num">Cost / lead</th></tr></thead>
                    <tbody>
                        @foreach (var c in Model.GoogleCampaigns)
                        {
                            <tr><td>@c.Name</td><td><span class="chip @(c.Status == "ENABLED" ? "good" : "")">@GoogleAdsService.StatusLabel(c.Status)</span></td><td class="num">@Format.Money(c.Cost)</td><td class="num">@c.Impressions.ToString("#,0")</td><td class="num">@c.Clicks.ToString("#,0")</td><td class="num">@(c.ClickRate is { } ctr ? ctr.ToString("0.0") + "%" : "—")</td><td class="num">@Format.Number(c.Conversions)</td>@if (report.PhoneCallsAvailable) { <td class="num">@c.PhoneCalls?.ToString("#,0")</td> }<td class="num">@Format.Money(c.CostPerLead)</td></tr>
                        }
                        @if (Model.GoogleCampaigns.Count == 0) { <tr><td colspan="9" class="muted">No Google Ads spend in this period.</td></tr> }
                    </tbody>
                </table>
            </div>
        }
    </section>

    <partial name="_MetaAds" model="Model.Meta" />

    @if (Model.Error is null)
    {
    <section class="card fin-section">
        <h2 class="section-title">Ads → revenue by lead source</h2>
        <p class="muted small">Jobs sold (open + last year) by the customer's <b>Lead Source</b> in JobTread. The website form sets it from the ad click (Google Ad, Meta, NextDoor), otherwise it's set by hand. Google Ad and Google count as Google Ads, Meta as Facebook/Instagram. Spend: @(Model.ApiChannels.Count > 0 ? $"{string.Join("; ", Model.ApiChannels.Select(a => $"{a.Channel} from the {(a.Api == "Meta" ? "Meta Marketing" : a.Api)} API"))}; other channels are entered by hand." : "entered by hand.") Platform leads are what the ad platform reports. <b>JT leads</b> are new JobTread customer accounts created @Model.From.ToString("MMM yyyy") – @Model.To.ToString("MMM yyyy") with that Lead Source. <b>Close rate</b> is how many of those new accounts already have a sold job.</p>
        @if (Model.JtLeads is { Untagged: > 0 } untagged)
        {
            <p class="muted small">@untagged.Untagged.ToString("#,0") of @untagged.Total.ToString("#,0") new customer accounts in this period have no Lead Source in JobTread, so they aren't in any row. Sold jobs whose customer has no Lead Source are listed at the bottom by "How bid came in".</p>
        }
        @if (Model.ReplacedSpend.Count > 0)
        {
            var rs = Model.ReplacedSpend.Values.ToList();
            <p class="notice-inline warn small">@rs.Count hand-entered @(rs.Count == 1 ? "row isn't" : "rows aren't") counted (@string.Join(", ", rs.OrderBy(r => r.Row.Month).Select(r => $"{r.Row.Channel} {r.Row.Month}"))): the API has that channel and month, so the API figure is used instead, never both (see "Spend entered").</p>
        }
        <div class="table-wrap">
            <table class="data">
                <thead><tr><th>Lead source</th><th class="num">Jobs</th><th class="num">Contract</th><th class="num">Spend</th><th class="num" title="Leads reported by the ad platform">Platform leads</th><th class="num" title="New JobTread customer accounts in the period with this Lead Source">JT leads</th><th class="num">Cost / JT lead</th><th class="num" title="New accounts in the period that have a sold job ÷ JT leads">Close rate</th><th class="num" title="Contract per $1 spent">Contract / $1</th></tr></thead>
                <tbody>
                    @foreach (var s in Model.Sources)
                    {
                        <tr class="@(s.NoLeadSource ? "muted" : "")"><td>@s.Source@if (s.FromApi) { <span class="chip good api-chip" title="Spend and leads from the @s.ApiSource API">API</span> }</td><td class="num">@s.Jobs</td><td class="num">@Format.Money(s.Contract)</td><td class="num">@(s.Spend > 0 ? Format.Money(s.Spend) : "—")</td><td class="num">@(s.Leads is { } l ? Format.Number(l) : "—")</td><td class="num">@(s.JtLeads?.ToString("#,0") ?? "—")</td><td class="num">@(s.CostPerJtLead is { } cpl ? Format.Money(cpl) : "—")</td><td class="num" title="@(s.CloseRate is not null ? $"{s.WonLeads} of {s.JtLeads} new accounts have a sold job" : "")">@(s.CloseRate is { } cr ? Format.Percent(100m * cr) : "—")</td><td class="num">@(s.Spend > 0 ? (s.Contract / s.Spend).ToString("$0.00") : "—")</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </section>

    @if (Model.CanEditAds)
    {
        <section class="card fin-section">
            <h2 class="section-title">Enter monthly spend</h2>
            <form method="post" asp-page-handler="Spend" asp-route-period="@Model.Period" class="inline-form wrap">
                <label class="field"><span>Month</span><input type="month" name="month" value="@LocalClock.Today.ToString("yyyy-MM")" required></label>
                <label class="field"><span>Channel</span><input name="channel" list="channels" required placeholder="e.g. Facebook"></label>
                <datalist id="channels">@foreach (var s in Model.Sources.Where(s => !s.NoLeadSource)) { <option value="@s.Source"></option> }</datalist>
                <label class="field"><span>Amount</span><input name="amount" inputmode="decimal" required style="width:120px"></label>
                <label class="field"><span>Leads (optional)</span><input type="number" name="leads" min="0" style="width:110px"></label>
                <button class="button" type="submit">Save</button>
            </form>
            <p class="muted small">Use the channel names in the table above (JobTread's Lead Source; "Nextdoor", "Google Ads", "Facebook/Instagram" and their usual spellings line up automatically). Saving the same month and channel again replaces it.@(Model.ApiChannels.Count > 0 ? $" {apiNames} {(Model.ApiChannels.Count == 1 ? "comes" : "come")} from the API for the last 12 months; no need to enter {(Model.ApiChannels.Count == 1 ? "it" : "them")}. Nextdoor and other channels without an API stay manual." : "")</p>
        </section>
    }

    @if (Model.Spend.Count > 0)
    {
        <section class="card fin-section">
            <h2 class="section-title">Spend entered</h2>
            <div class="table-wrap">
                <table class="data">
                    <thead><tr><th>Month</th><th>Channel</th><th class="num">Amount</th><th class="num">Leads</th><th></th></tr></thead>
                    <tbody>
                        @foreach (var s in Model.Spend)
                        {
                            var r = Model.ReplacedSpend.GetValueOrDefault(s.Id);
                            <tr class="@(r is not null ? "replaced" : "")"><td>@s.Month</td><td>@s.Channel@if (r is not null) { <span class="chip warn api-chip" title="@r.ApiName API for @s.Month: @Format.Money(r.ApiAmount)">Not counted · API: @Format.Money(r.ApiAmount)</span> }</td><td class="num">@Format.Money(s.Amount)</td><td class="num">@(s.Leads?.ToString() ?? "—")</td>
                                <td>@if (Model.CanEditAds) { <form method="post" asp-page-handler="DeleteSpend" asp-route-period="@Model.Period" onsubmit="return confirm('Delete?')"><input type="hidden" name="id" value="@s.Id"><button class="link-button" type="submit">Delete</button></form> }</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </section>
    }
    }
}

@functions {
    static string IndexModelPct(decimal part, decimal whole) => whole == 0 ? "—" : Format.Percent(100m * part / whole);
    static string MonthLabel(string month) => DateOnly.TryParseExact(month + "-01", "yyyy-MM-dd", out var d) ? d.ToString("MMM yyyy", System.Globalization.CultureInfo.GetCultureInfo("en-US")) : month;
    static string AdsAccountId(string? id) => id is null ? "" : AdsAccount.FormatId(id);
}

@section Scripts {
    <script src="~/js/site.js" asp-append-version="true"></script>
}

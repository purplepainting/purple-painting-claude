                    <tbody>
                        @foreach (var j in dd.Jobs)
                        {
                            <tr>
                                <td><a href="@JobTreadIds.JobUrl(j.Id)" target="_blank" rel="noopener"><span class="num">#@j.Number</span> @j.Name ↗</a></td>
                                <td data-label="Customer">@if (j.CustomerId is { } cust) { <a href="@JobTreadIds.CustomerUrl(cust)" target="_blank" rel="noopener">@(j.Customer ?? "—")</a> } else { @(j.Customer ?? "—") }</td>
                                <td data-label="Lead source">@(j.CustomerLeadSource ?? "—")</td>
                                <td data-label="How bid came in">@(j.HowBidCameIn ?? "—")</td>
                                <td class="num" data-label="Sold on">@(j.FirstApprovedOrderOn?.ToString("MMM d, yyyy", dateFmt) ?? "—")</td>
                                <td data-label="Stage">@(j.Stage ?? "—")@if (j.ClosedOn is { } closed) { <span class="muted small"> · closed @closed.ToString("MMM d, yyyy", dateFmt)</span> }</td>
                                <td class="num" data-label="Contract">@Format.Money(j.Contract)</td>
                            </tr>
                        }
                        @if (dd.Jobs.Count == 0) { <tr><td colspan="7" class="muted">No sold jobs here.</td></tr> }
                    </tbody>
                    <tfoot><tr class="total"><td>Total · @dd.Count job@(dd.Count == 1 ? "" : "s")</td><td></td><td></td><td></td><td></td><td></td><td class="num" data-label="Contract">@Format.Money(dd.Contract)</td></tr></tfoot>
                </table>
            }
        </div>
    </section>
}
else if (Model.CurrentTab == "ads")

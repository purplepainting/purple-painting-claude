@page "/sales"
@model PurpleDashboard.Pages.Sales.IndexModel
@using PurpleDashboard.Infrastructure
@using PurpleDashboard.Integrations.JobTread
@using PurpleDashboard.Modules.Sales
@using PurpleDashboard.Integrations.Google

<div class="module-head">
    <div class="pills" role="tablist" aria-label="Sales sections">
        @foreach (var (key, label) in Model.Tabs)
        {
            <a class="pill@(Model.CurrentTab == key ? " active" : "")" asp-page="/Sales/Index" asp-route-tab="@(key == "ads" ? null : key)">@label</a>
        }
    </div>
    @if (Model.CurrentTab != "commissions")
    {
        <form class="filters ads-bar" method="get" data-autosubmit>
            @if (Model.CurrentTab == "ads")
            {
                <nav class="pills wrap channel-pills" aria-label="Ad channel">
                    @foreach (var (key, label) in AdChannels.Pills)
                    {
                        <a class="pill@(Model.CurrentChannel == key ? " active" : "")" asp-page="/Sales/Index" asp-all-route-data="Model.AdsRoute(key)" aria-current="@(Model.CurrentChannel == key ? "page" : null)">@label</a>
                    }
                </nav>
                @if (Model.CurrentChannel is { } ch) { <input type="hidden" name="channel" value="@ch"> }
                @if (Model.CurrentList is { } dl)
                {
                    @* Changing the period on a drill-down keeps the list (same scope, new period). *@
                    <input type="hidden" name="list" value="@dl">
                    @if (!string.IsNullOrWhiteSpace(Model.Group)) { <input type="hidden" name="group" value="@Model.Group"> }
                    @if (!string.IsNullOrWhiteSpace(Model.Source)) { <input type="hidden" name="source" value="@Model.Source"> }
                }
            }
            else
            {
                <input type="hidden" name="tab" value="@Model.CurrentTab">
            }
            <select name="period" aria-label="Period">
                <option value="30" selected="@(Model.Period == "30")">Last 30 days</option>
                <option value="" selected="@(Model.Period is null or "90")">Last 90 days</option>
                <option value="ytd" selected="@(Model.Period == "ytd")">Year to date</option>
                @if (Model.CurrentTab == "ads") { <option value="12" selected="@(Model.Period == "12")">Last 12 months</option> }
            </select>
        </form>
    }
</div>

@if (Model.Message is not null && Model.Open is null) { <div class="card notice"><p>@Model.Message</p></div> }
@if (!Model.CanEdit) { <div class="card notice warn"><p>The dashboard database isn't available, so nothing can be saved right now.</p></div> }
@if (Model.Error is not null) { <div class="card notice warn"><strong>Couldn't load.</strong><p>@Model.Error</p></div> }

@if (Model.CurrentTab == "commissions" && Model.Error is null)
{
    <p class="list-meta muted">Salesperson comes from each job in JobTread. @(Model.CanEditCommissions ? "Set each person's rate below; " : "")"collected" pays as the customer pays (invoices minus unpaid, before retention).</p>

    <section class="card fin-section">
        <h2 class="section-title">Salespeople</h2>
        <div class="table-wrap">
            <table class="data">
                <thead><tr><th>Person</th><th>Rate</th><th class="num">Jobs</th><th class="num">Earned</th><th class="num">Paid</th><th class="num">Owed</th></tr></thead>
                <tbody>
                    @foreach (var p in Model.People)
                    {
                        <tr>
                            <td>
                                @if (!Model.CanEditCommissions) { <b>@p.Person</b> } else {
                                <details class="acct-list">
                                    <summary><b>@p.Person</b></summary>
                                    <form method="post" asp-page-handler="Rule" class="inline-form">
                                        <input type="hidden" name="person" value="@p.Person">
                                        <input name="percent" inputmode="decimal" value="@(p.Rule?.Percent.ToString("0.##"))" placeholder="%" aria-label="Commission percent" style="width:70px" required>
                                        <select name="basis" aria-label="Commission based on">
                                            @foreach (var b in SalesService.Bases) { <option value="@b" selected="@((p.Rule?.Basis ?? "collected") == b)">% @SalesService.BasisLabel(b)</option> }
                                        </select>
                                        <input name="notes" value="@p.Rule?.Notes" placeholder="Notes (optional)" aria-label="Notes">
                                        <button class="button secondary" type="submit">Save</button>
                                    </form>
                                </details>
                                }
                            </td>
                            <td class="@(p.Rule is null ? "neg" : "")">@IndexModel.Rate(p.Rule)</td>
                            <td class="num">@p.Jobs</td>
                            <td class="num">@Format.Money(p.Earned)</td>
                            <td class="num">@Format.Money(p.Paid + p.Unallocated)@if (p.Unallocated != 0) { <div class="muted small" title="Paid through payroll beyond their owed jobs; lowers what they're owed">incl. @Format.Money(p.Unallocated) unallocated</div> }</td>
                            <td class="num"><b>@Format.Money(p.Owed)</b></td>
                        </tr>
                    }
                    <tr class="total"><td>Total</td><td></td><td class="num">@Model.People.Sum(p => p.Jobs)</td><td class="num">@Format.Money(Model.People.Sum(p => p.Earned))</td><td class="num">@Format.Money(Model.People.Sum(p => p.Paid + p.Unallocated))</td><td class="num">@Format.Money(Model.People.Sum(p => p.Owed))</td></tr>
                </tbody>
            </table>
        </div>
    </section>

    <div class="pills">
        <a class="pill@(Model.Show != "all" ? " active" : "")" asp-page="/Sales/Index" asp-route-tab="commissions">Owed</a>
        <a class="pill@(Model.Show == "all" ? " active" : "")" asp-page="/Sales/Index" asp-route-tab="commissions" asp-route-show="all">All jobs</a>
    </div>
    <div class="job-list" style="margin-top:10px">
        @if (Model.Show != "all" && Model.JobsWithoutRate > 0)
        {
            <p class="list-meta muted">@Model.JobsWithoutRate job@(Model.JobsWithoutRate == 1 ? "" : "s") can't owe anything until the salesperson has a commission rate: set rates in the table above, or see <a asp-page="/Sales/Index" asp-route-tab="commissions" asp-route-show="all">All jobs</a>.</p>
        }
        @if (!Model.ShownCommissions.Any()) { <div class="card empty-state"><p class="muted">Nothing owed right now.</p></div> }
        @foreach (var c in Model.ShownCommissions)
        {
            var jobPayments = Model.Payments.Where(p => p.JobId == c.JobId).OrderByDescending(p => p.PaidOn).ThenByDescending(p => p.Id).ToList();
            <details class="job card emp" id="comm-@c.JobId" open="@(Model.Open == c.JobId)">
                <summary class="emp-row with-chip">
                    <span class="chip">@c.Person.Split(' ')[0]</span>
                    <div class="job-main">
                        <div class="job-title">#@c.Number @c.JobName</div>
                        <div class="job-sub muted">@c.Stage · contract @Format.Money(c.Contract) · collected @Format.Money(c.Collected)</div>
                    </div>
                    <span class="emp-rates num"><span>Earned @Format.Money(c.Earned)</span><span class="muted">Paid @Format.Money(c.Paid)</span></span>
                    <span class="emp-hours num"><b>@(c.Rule is null ? "set rate" : Format.Money(c.Owed))</b></span>
                    <span class="chevron" aria-hidden="true"></span>
                </summary>
                <div class="job-detail bonus-detail">
                    <p class="muted small">@c.Person: @IndexModel.Rate(c.Rule) · job profit @Format.Money(c.Profit) · <a href="@JobTreadIds.JobUrl(c.JobId)" target="_blank" rel="noopener">JobTread ↗</a></p>
                    @if (Model.CanEditCommissions)
                    {
                        <form method="post" asp-page-handler="Pay" asp-route-show="@Model.Show" class="inline-form">
                            <input type="hidden" name="jobId" value="@c.JobId"><input type="hidden" name="jobName" value="@c.JobName"><input type="hidden" name="person" value="@c.Person">
                            <input name="amount" inputmode="decimal" value="@(c.Owed > 0 ? c.Owed.ToString("0.00") : "")" placeholder="Amount" aria-label="Amount paid" style="width:110px" required>
                            <input type="date" name="paidOn" value="@LocalClock.Today.ToString("yyyy-MM-dd")" aria-label="Paid on">
                            <input name="note" placeholder="Note (e.g. check #, payroll date)" aria-label="Note">
                            <button class="button" type="submit">Record payment</button>
                        </form>
                    }
                    @if (Model.Open == c.JobId && Model.Message is not null) { <p class="notice-inline good">@Model.Message</p> }
                    @if (jobPayments.Count > 0)
                    {
                        <table class="data compact" style="margin-top:8px">
                            <thead><tr><th>Paid</th><th class="num">Amount</th><th>Note</th><th></th></tr></thead>
                            <tbody>
                                @foreach (var p in jobPayments)
                                {
                                    <tr>
                                        <td>@Format.Date(p.PaidOn)</td><td class="num">@Format.Money(p.Amount)</td><td class="muted">@p.Note</td>
                                        <td>@if (Model.IsLocked(p.Person, p.PaidOn)) { <span class="muted small" title="Paid & locked month">🔒</span> } else if (Model.CanEditCommissions) { <form method="post" asp-page-handler="DeletePayment" asp-route-show="@Model.Show" onsubmit="return confirm('Delete this payment record?')"><input type="hidden" name="id" value="@p.Id"><input type="hidden" name="jobId" value="@c.JobId"><button class="link-button" type="submit">Delete</button></form> }</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                </div>
            </details>
        }
    </div>

    @if (Model.Checks is { } chk)
    {
        var cm = chk.Month;
        var cmKey = CommissionPayroll.Key(cm);
        var cmLabel = CommissionPayroll.Label(cm);
        string Cents(decimal d) => d.ToString("$#,##0.00;-$#,##0.00");
        bool InlineFor(string id) => Model.Open == id && Model.Message is not null;
        <section class="fin-section-plain" id="checks" style="margin-top:16px">
            <div style="display:flex;flex-wrap:wrap;gap:8px;align-items:center;justify-content:space-between">
                <h2 class="section-title">Payroll checks · @cmLabel</h2>
                <form method="get" data-autosubmit class="filters">
                    <input type="hidden" name="tab" value="commissions">
                    @if (Model.Show is not null) { <input type="hidden" name="show" value="@Model.Show"> }
                    <select name="month" aria-label="Payroll month">
                        @foreach (var m in CommissionPayroll.Months()) { <option value="@CommissionPayroll.Key(m)" selected="@(m == cm)">@CommissionPayroll.Label(m)</option> }
                    </select>
                </form>
            </div>
            @if (!chk.Payroll.Ok)
            {
                <div class="card notice warn"><p>@chk.Payroll.Problem</p></div>
            }
            else
            {
                <p class="muted small">"Commission" paycheck lines posted in QuickBooks in @cmLabel (@string.Join(", ", chk.Payroll.Accounts)), gross, matched to salespeople by QuickBooks employee id, then name, and compared with the commission payments recorded here dated in @cmLabel (tolerance $1). Owed now is today's balance on all their jobs.
                    @if (Model.QbAsOf is { } asOf) { <span>QuickBooks as of @asOf.ToLocalTime().ToString("MMM d h:mm tt") · <a asp-page="/Sales/Index" asp-route-tab="commissions" asp-route-month="@cmKey" asp-route-show="@Model.Show" asp-route-qbRefresh="true" asp-fragment="checks">Refresh</a></span> }</p>
                <details class="acct-list small" style="margin-bottom:8px">
                    <summary>How "Record from payroll" and locking work</summary>
                    <p class="muted small"><b>Record from payroll</b> records what payroll paid beyond what's recorded here, dated on the check: it pays off the person's owed jobs oldest first (lowest JobTread job number), and anything left over (payroll paid more than their jobs owe, e.g. an advance) is kept as one <b>unallocated</b> payment that lowers their owed total. Delete it under Recent payments if it was a mistake.</p>
                    <p class="muted small"><b>Paid &amp; locked</b> saves a snapshot of the person's month (each job's commission earned and what was paid in @cmLabel, the check and gross). Payments dated in a locked month can't be added or deleted. If a job's commission changes later (JobTread contract, collected or profit), the change shows in the next open month as an adjustment; it's already counted in owed now. Unlocking needs a reason and is change-logged.</p>
                </details>
                @if (InlineFor("checks")) { <p class="notice-inline good">@Model.Message</p> }
                <div class="card table-wrap">
                    <table class="data stack-phone">
                        <thead><tr><th>Salesperson</th><th class="num">Owed now</th><th class="num">Recorded in @cm.ToString("MMM")</th><th class="num">Payroll (gross)</th><th>Checks</th><th>Status</th><th></th></tr></thead>
                        <tbody>
                            @if (chk.Rows.Count == 0) { <tr><td colspan="7" class="muted">No commission owed, recorded or paid through payroll in @cmLabel.</td></tr> }
                            @foreach (var c in chk.Rows)
                            {
                                var slug = IndexModel.Slug(c.Name);
                                <tr id="chk-@slug">
                                    <td>@c.Name</td>
                                    <td class="num" data-label="Owed now">@Cents(c.OwedNow)</td>
                                    <td class="num" data-label="Recorded in @cm.ToString("MMM")">@Cents(c.Recorded)</td>
                                    <td class="num" data-label="Payroll (gross)">@Cents(c.Payroll)</td>
                                    <td class="small" data-label="Checks">@foreach (var ch in c.Checks) { <div>#@(ch.Num ?? "—") · @Format.Date(ch.Date) · @Cents(ch.Amount)</div> }@if (c.Checks.Count == 0) { <span class="muted">—</span> }</td>
                                    <td>
                                        <span class="chip @c.Chip">@(c.Lock is not null ? "🔒 " : "")@c.Status</span>
                                        @if (c.Detail is { } d) { <div class="muted small">@d</div> }
                                        @if (c.Lock is { } lk) { <div class="muted small">by @lk.LockedBy @Format.Date(DateOnly.FromDateTime(lk.LockedAt.ToLocalTime())): paid @Cents(lk.Net)@(lk.Gross is { } g ? $", gross {Cents(g)}" : "")@(lk.CheckNum is { } cn ? $", check {cn}" : "")</div> }
                                        @if (c.Adjustment is { } adj) { <div class="small @(adj.Amount < 0 ? "neg" : "")">Adjustment for @CommissionPayroll.Label(adj.LockedMonth): @(adj.Amount > 0 ? "+" : "")@Cents(adj.Amount) (@string.Join(", ", adj.Jobs) changed after it was locked; in owed now)</div> }
                                    </td>
                                    <td class="actions">
                                        @if (Model.CanEditCommissions && c.Unrecorded > 0 && c.Lock is null)
                                        {
                                            <form method="post" asp-page-handler="PayFromPayroll" asp-route-month="@cmKey" asp-route-show="@Model.Show"><input type="hidden" name="person" value="@c.Name"><button class="button secondary" type="submit" title="Record @Cents(c.Unrecorded) from the payroll check">Record from payroll</button></form>
                                        }
                                        @if (Model.CanEditCommissions && c.CanLock)
                                        {
                                            <form method="post" asp-page-handler="Lock" asp-route-month="@cmKey" asp-route-show="@Model.Show" onsubmit="@(c.Unrecorded > 0 ? "return confirm(" + System.Text.Json.JsonSerializer.Serialize($"Record {Cents(c.Unrecorded)} from payroll and lock {c.Name} for {cmLabel}?") + ")" : null)"><input type="hidden" name="person" value="@c.Name"><button class="link-button" type="submit">Lock</button></form>
                                        }
                                        @if (Model.CanEditCommissions && c.Lock is not null)
                                        {
                                            <details class="unlock"><summary class="link-button">Unlock</summary>
                                                <form method="post" asp-page-handler="Unlock" asp-route-month="@cmKey" asp-route-show="@Model.Show" class="inline-form"><input type="hidden" name="person" value="@c.Name"><input name="reason" placeholder="Reason (required)" aria-label="Reason for unlocking" required><button class="button secondary" type="submit">Unlock</button></form>
                                            </details>
                                        }
                                    </td>
                                </tr>
                                @if (c.Payments.Count > 0)
                                {
                                    <tr><td colspan="7" class="small muted" style="font-weight:400">Recorded: @string.Join(" · ", c.Payments.Select(p => $"{Format.Date(p.PaidOn)} {Cents(p.Amount)} {(p.JobId == CommissionPayroll.Unallocated ? "unallocated" : p.JobName)}"))</td></tr>
                                }
                                @if (InlineFor("chk-" + slug)) { <tr><td colspan="7"><p class="notice-inline good">@Model.Message</p></td></tr> }
                            }
                        </tbody>
                        <tfoot><tr><td>Total</td><td class="num" data-label="Owed now">@Cents(chk.Rows.Sum(x => x.OwedNow))</td><td class="num" data-label="Recorded in @cm.ToString("MMM")">@Cents(chk.Rows.Sum(x => x.Recorded))</td><td class="num" data-label="Payroll (gross)">@Cents(chk.Rows.Sum(x => x.Payroll))</td><td colspan="3"></td></tr></tfoot>
                    </table>
                </div>
                @if (Model.CanEditCommissions && chk.Rows.Any(x => x.ReadyToLock))
                {
                    <form method="post" asp-page-handler="Lock" asp-route-month="@cmKey" asp-route-show="@Model.Show" class="form-actions" style="margin-top:10px" onsubmit="return confirm('Lock everyone whose payroll check matches what is recorded for @cmLabel?')">
                        <button class="button" type="submit">Lock @cmLabel</button>
                        <span class="muted small">Locks everyone whose check matches. Others stay open (Record from payroll first, or Lock them one by one).</span>
                    </form>
                }
            }
        </section>
    }

    @if (Model.Payments.Count > 0)
    {
        <section class="card fin-section" style="margin-top:12px">
            <h2 class="section-title">Recent payments</h2>
            <div class="table-wrap">
                <table class="data">
                    <thead><tr><th>Paid</th><th>Person</th><th>Job</th><th class="num">Amount</th><th>Note</th><th></th></tr></thead>
                    <tbody>
                        @foreach (var p in Model.Payments)
                        {
                            <tr>
                                <td>@Format.Date(p.PaidOn)</td><td>@p.Person</td><td>@p.JobName</td><td class="num">@Format.Money(p.Amount)</td><td class="muted">@p.Note</td>
                                <td>@if (Model.IsLocked(p.Person, p.PaidOn)) { <span class="muted small" title="Paid & locked month">🔒</span> } else if (Model.CanEditCommissions) { <form method="post" asp-page-handler="DeletePayment" asp-route-show="@Model.Show" onsubmit="return confirm('Delete this payment record?')"><input type="hidden" name="id" value="@p.Id"><button class="link-button" type="submit">Delete</button></form> }</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </section>
    }
}
else if (Model.CurrentTab == "doors" && Model.Error is null)
{
    var a = Model.Activity;
    <div class="kpis">
        <div class="card kpi"><span class="kpi-label">Doors</span><span class="kpi-value num">@a.Sum(x => x.Doors).ToString("#,0")</span></div>
        <div class="card kpi"><span class="kpi-label">Leads</span><span class="kpi-value num">@a.Sum(x => x.Leads)</span><span class="kpi-sub num">@IndexModelPct(a.Sum(x => x.Leads), a.Sum(x => x.Doors)) of doors</span></div>
        <div class="card kpi"><span class="kpi-label">Sold</span><span class="kpi-value num">@a.Sum(x => x.Sold)</span><span class="kpi-sub num">@IndexModelPct(a.Sum(x => x.Sold), a.Sum(x => x.Leads)) of leads</span></div>
        <div class="card kpi"><span class="kpi-label">Sold $</span><span class="kpi-value num">@Format.Money(a.Sum(x => x.SoldAmount))</span></div>
    </div>

    @if (Model.CanEditDoors)
    {
        <section class="card fin-section">
            <h2 class="section-title">Log activity</h2>
            <form method="post" asp-page-handler="Activity" asp-route-period="@Model.Period" class="inline-form wrap">
                <label class="field"><span>Date</span><input type="date" name="date" value="@LocalClock.Today.ToString("yyyy-MM-dd")"></label>
                <label class="field"><span>Rep</span><input name="rep" required list="reps"></label>
                <datalist id="reps">@foreach (var r in a.Select(x => x.Rep).Distinct()) { <option value="@r"></option> }</datalist>
                <label class="field"><span>Doors</span><input type="number" name="doors" min="0" value="0" style="width:90px"></label>
                <label class="field"><span>Leads</span><input type="number" name="leads" min="0" value="0" style="width:90px"></label>
                <label class="field"><span>Sold</span><input type="number" name="sold" min="0" value="0" style="width:90px"></label>
                <label class="field"><span>Sold $</span><input name="soldAmount" inputmode="decimal" style="width:110px"></label>
                <label class="field grow"><span>Notes</span><input name="notes"></label>
                <button class="button" type="submit">Log</button>
            </form>
        </section>
    }

    <section class="card fin-section">
        <h2 class="section-title">By rep</h2>
        <div class="table-wrap">
            <table class="data">
                <thead><tr><th>Rep</th><th class="num">Days</th><th class="num">Doors</th><th class="num">Leads</th><th class="num">Sold</th><th class="num">Sold $</th></tr></thead>
                <tbody>
                    @foreach (var g in a.GroupBy(x => x.Rep).OrderByDescending(g => g.Sum(x => x.SoldAmount)))
                    {
                        <tr><td>@g.Key</td><td class="num">@g.Select(x => x.Date).Distinct().Count()</td><td class="num">@g.Sum(x => x.Doors)</td><td class="num">@g.Sum(x => x.Leads)</td><td class="num">@g.Sum(x => x.Sold)</td><td class="num">@Format.Money(g.Sum(x => x.SoldAmount))</td></tr>
                    }
                    @if (a.Count == 0) { <tr><td colspan="6" class="muted">Nothing logged in this period.</td></tr> }
                </tbody>
            </table>
        </div>
    </section>

    @if (a.Count > 0)
    {
        <section class="card fin-section">
            <h2 class="section-title">Log</h2>
            <div class="table-wrap">
                <table class="data">
                    <thead><tr><th>Date</th><th>Rep</th><th class="num">Doors</th><th class="num">Leads</th><th class="num">Sold</th><th class="num">Sold $</th><th>Notes</th><th></th></tr></thead>
                    <tbody>
                        @foreach (var x in a)
                        {
                            <tr><td>@Format.Date(x.Date)</td><td>@x.Rep</td><td class="num">@x.Doors</td><td class="num">@x.Leads</td><td class="num">@x.Sold</td><td class="num">@Format.Money(x.SoldAmount)</td><td class="muted">@x.Notes</td>
                                <td>@if (Model.CanEditDoors) { <form method="post" asp-page-handler="DeleteActivity" asp-route-period="@Model.Period" onsubmit="return confirm('Delete this entry?')"><input type="hidden" name="id" value="@x.Id"><button class="link-button" type="submit">Delete</button></form> }</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </section>
    }
}
else if (Model.CurrentTab == "ads" && Model.Drilldown is { } dd)
{
    var leads = dd.IsLeads;
    var dch = Model.CurrentChannel;
    var backFragment = !string.IsNullOrWhiteSpace(Model.Source) ? (dch == AdChannels.Other ? "other-channels" : dch is null ? "lead-sources" : null) : dch is null && Model.Group is not null ? "by-channel" : null;
    var dateFmt = System.Globalization.CultureInfo.GetCultureInfo("en-US");
    <section class="card fin-section drill" id="drill">
        <a class="drill-back" asp-page="/Sales/Index" asp-all-route-data="Model.AdsRoute()" asp-fragment="@backFragment">← Back to ads</a>
        <h2 class="section-title">@dd.Scope · @(leads ? "JobTread leads" : "Jobs sold") · @(leads ? Model.PeriodLabel : "open + last year") <span class="num">(@dd.Count)</span></h2>
        @if (leads)
        {
            <p class="muted small">New customer accounts created in JobTread @Model.JtLeads?.From.ToString("MMM d, yyyy", dateFmt) – @Model.JtLeads?.To.ToString("MMM d, yyyy", dateFmt) (whole months, like spend)@(dd.Scope == "No lead source" ? " with no Lead Source" : dd.Scope == "All channels" ? "" : " whose Lead Source is counted in " + dd.Scope), newest first. <b>Sold</b> = the account has a sold job (open, or closed in the last year, with a contract); <b>click id</b> is the ad click the website form turns into that Lead Source (it can also be picked by hand).</p>
        }
        else
        {

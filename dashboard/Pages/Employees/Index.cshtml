@page "/employees"
@model PurpleDashboard.Pages.Employees.IndexModel
@using PurpleDashboard.Infrastructure
@using PurpleDashboard.Modules.People

<div class="module-head">
    <div class="pills" role="tablist" aria-label="Who to show">
        @foreach (var (key, label) in new[] { ((string?)null, "Everyone"), ("crew", "Crew"), ("supervisors", "Management & office") })
        {
            var active = Model.Show == key;
            <a class="pill@(active ? " active" : "")" asp-page="/Employees/Index" asp-all-route-data="Model.RouteFor(key)" aria-current="@(active ? "page" : null)">@label</a>
        }
        <a class="pill" href="/employees/interviews">Hiring</a>
    </div>
    <form class="filters" method="get">
        @if (Model.Show is not null) { <input type="hidden" name="show" value="@Model.Show"> }
        @if (Model.Former) { <input type="hidden" name="former" value="true"> }
        <input type="search" name="q" value="@Model.Q" placeholder="Search name, role or level" aria-label="Search employees">
        <button class="button secondary" type="submit">Search</button>
        @if (!string.IsNullOrWhiteSpace(Model.Q)) { <a class="link-button" asp-page="/Employees/Index" asp-route-show="@Model.Show">Clear</a> }
    </form>
</div>

@if (!Model.DbCanSave)
{
    <div class="card notice warn">
        <strong>Read only for now.</strong>
        <p>
            @if (!Model.Database.Configured) { <text>The dashboard database isn't connected yet, so levels and colors come from settings and can't be changed here.</text> }
            else { <text>The dashboard database couldn't be reached, so changes can't be saved. Levels and colors come from settings until it's back.</text> }
        </p>
    </div>
}

@if (Model.Error is not null)
{
    <div class="card notice warn">
        <strong>Couldn't load employees.</strong>
        <p>@Model.Error</p>
    </div>
}
else
{
    <p class="list-meta muted">
        @Model.Total people (from JobTread; new people show up here on their own)@(Model.ShowPay ? " · QB = QuickBooks base pay · JT = JobTread burdened rate" : "") · hours are this week
        @if (Model.FormerIds.Count > 0)
        {
            <text> · </text>
            @if (Model.Former) { <a asp-page="/Employees/Index" asp-route-show="@Model.Show" asp-route-q="@Model.Q">Hide former employees</a> }
            else { <a asp-page="/Employees/Index" asp-route-show="@Model.Show" asp-route-q="@Model.Q" asp-route-former="true">Show @Model.FormerIds.Count former employee@(Model.FormerIds.Count == 1 ? "" : "s")</a> }
            <span title="Inactive in QuickBooks but still a member in JobTread: remove them in JobTread to clear this.">(off payroll, still in JobTread)</span>
        }
    </p>

    @foreach (var (title, members) in new[] { ("Crew", Model.Crew), ("Management & office", Model.Supervisors) })
    {
        if (members.Count == 0) continue;
        <h2 class="section-title">@title <span class="muted">@members.Count</span></h2>
        <div class="job-list">
            @foreach (var m in members)
            {
                var s = m.Staff;
                <details class="job card emp" id="emp-@s.MembershipId" data-detail-url="/employees/@s.MembershipId/detail" data-error="Couldn’t load this person. Close and reopen to try again." open="@(Model.Open == s.MembershipId)">
                    <summary class="emp-row">
                        <span class="avatar @m.ChipClass" style="@m.ChipStyle" aria-hidden="true">@IndexModel.Initials(s.Name)</span>
                        <div class="job-main">
                            <div class="job-title">@s.Name</div>
                            <div class="job-sub muted">
                                @s.Role
                                @if (Model.ShowPay) { <span class="emp-rates-inline num">· QB @IndexModel.Pay(m.Profile?.QbBasePay, m.Profile?.QbPayType) · JT @IndexModel.Pay(s.BaseRate?.HourlyRate, null)</span> }
                                @if (Model.FormerIds.Contains(s.MembershipId)) { <span class="chip bad small-chip" title="Inactive in QuickBooks but still a member in JobTread">Off payroll · still in JobTread</span> }
                                @if (s.QboEmployeeId is null) { <span class="chip warn small-chip" title="No QuickBooks employee linked in JobTread">No QuickBooks link</span> }
                                @if (m.Profile?.Notes is { } notes) { <span class="emp-note" title="@notes">· @notes</span> }
                            </div>
                        </div>
                        <span class="emp-figs">
                            <span class="pchip @m.ChipClass" style="@m.ChipStyle" title="@(m.LevelIsSet ? "Set on this page" : "Default (from settings / JobTread role)")">@m.LevelLabel@(m.LevelIsSet ? "" : "*")</span>
                            @if (Model.ShowPay && m.SuggestedLevel is { } sl) { <span class="chip warn small-chip" title="QuickBooks base pay points to @Levels.Label(sl)">Pay says @Levels.Label(sl)</span> }
                            @if (m.IsSupervisor && (m.Staff.Role == "Project Manager" || !string.IsNullOrEmpty(m.Profile?.Color))) { <span class="pm-tag" style="@PmColorOptions.StyleFor(m.Color)">@s.FirstName</span> }
                            @if (Model.ShowPay)
                            {
                            <span class="emp-rates num">
                                <span title="QuickBooks base pay">QB @IndexModel.Pay(m.Profile?.QbBasePay, m.Profile?.QbPayType)</span>
                                <span class="muted" title="JobTread burdened rate@(s.BaseRate is { } br ? $" ({br.Name})" : "")">JT @IndexModel.Pay(s.BaseRate?.HourlyRate, null)</span>
                            </span>
                            }
                            <span class="emp-hours num muted">@(Model.Hours(m) > 0 ? Format.Number(Model.Hours(m)) + " hrs" : "—")</span>
                        </span>
                        <span class="chevron" aria-hidden="true"></span>
                    </summary>
                    <div class="job-detail">
                        <div class="job-detail-body" aria-live="polite"><p class="muted">Loading…</p></div>
                    </div>
                </details>
            }
        </div>
    }
    <p class="muted small">* Not set here yet: the level comes from settings (Crew lists) or the JobTread role.</p>
}

@section Scripts {
    <script src="~/js/site.js" asp-append-version="true"></script>
}

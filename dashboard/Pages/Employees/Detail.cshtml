@page "/employees/{id}/detail"
@model PurpleDashboard.Pages.Employees.DetailModel
@using PurpleDashboard.Infrastructure
@using PurpleDashboard.Integrations.JobTread
@using PurpleDashboard.Modules.People
@using PurpleDashboard.Modules.Financials
@{
    Layout = null;
}
@if (Model.Error is not null)
{
    <p class="notice-inline warn">@Model.Error</p>
}
else if (Model.Member is { } m)
{
    var p = m.Profile;
    <div class="emp-detail">
        <form class="emp-form" method="post" asp-page="/Employees/Index" asp-page-handler="Save">
            <input type="hidden" name="membershipId" value="@m.Staff.MembershipId">
            <fieldset disabled="@(!Model.CanEdit)">
                <label class="field">
                    <span>Level</span>
                    <select name="level">
                        <option value="">Default (@Levels.Label(Model.DefaultLevel))</option>
                        @foreach (var l in Levels.All)
                        {
                            <option value="@l" selected="@(p?.Level == l)">@Levels.Label(l)</option>
                        }
                    </select>
                    <small class="muted">Foreman $29+, Painter $23–28, Helper $16–22 QuickBooks base pay. Management goes on the Management schedule.</small>
                    @if (Model.ShowPay && m.SuggestedLevel is { } sl) { <small class="notice-inline warn">QuickBooks pay points to @Levels.Label(sl).</small> }
                </label>
                @if (m.IsSupervisor || !string.IsNullOrEmpty(p?.Color))
                {
                <div class="field">
                    <span>PM tag color</span>
                    <span class="color-row">
                        <input type="color" name="color" value="@m.Color">
                        <label class="check"><input type="checkbox" name="defaultColor" value="true" checked="@string.IsNullOrEmpty(p?.Color)"> Default</label>
                    </span>
                    <small class="muted">Used on the project and schedule PM tags. Uncheck Default to use the color picked.</small>
                </div>
                }
                @if (Model.CanEditPay)
                {
                <div class="field">
                    <span>QuickBooks base pay</span>
                    <span class="color-row">
                        <input name="qbBasePay" inputmode="decimal" placeholder="e.g. 24.00" value="@(p?.QbBasePay?.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture))" style="max-width:120px">
                        <select name="qbPayType" aria-label="Pay type" style="width:auto">
                            <option value="Hourly" selected="@(p?.QbPayType != "Salary")">per hour</option>
                            <option value="Salary" selected="@(p?.QbPayType == "Salary")">per year (salary)</option>
                        </select>
                    </span>
                    <small class="muted">Their regular rate in QuickBooks payroll (not burdened). Will fill in from QuickBooks pay stubs once Intuit allows it.</small>
                </div>
                }
                else if (Model.ShowPay)
                {
                <div class="field">
                    <span>QuickBooks base pay</span>
                    <span class="num">@IndexModel.Pay(p?.QbBasePay, p?.QbPayType)</span>
                </div>
                }
                <label class="field wide">
                    <span>Notes</span>
                    <textarea name="notes" rows="2" maxlength="2000" placeholder="e.g. Drives the spray rig, Spanish only, prevailing wage certified">@p?.Notes</textarea>
                </label>
                <div class="form-actions wide">
                    @if (Model.CanEdit) { <button class="button" type="submit">Save</button> }
                    @if (p is not null) { <span class="muted small">Last changed @Format.Date(DateOnly.FromDateTime(p.UpdatedAt.ToLocalTime())) by @p.UpdatedBy</span> }
                </div>
            </fieldset>
        </form>

        <div class="emp-jobs">
            @if (!Model.ShowPay) { }
            else if (m.Staff.Rates.Count == 0)
            {
                <h3 class="detail-title">JobTread burdened rates</h3>
                <p class="muted">No rates set in JobTread.</p>
            }
            else
            {
                <h3 class="detail-title">JobTread burdened rates</h3>
                <ul class="crew-list">
                    @foreach (var r in m.Staff.Rates)
                    {
                        <li><span class="crew-name">@r.Name</span><span class="crew-meta num">@IndexModel.Pay(r.HourlyRate, null)</span></li>
                    }
                </ul>
            }

            <h3 class="detail-title">Jobs in the last 30 days</h3>
            @if (Model.RecentJobs.Count == 0)
            {
                <p class="muted">No time clocked in the last 30 days.</p>
            }
            else
            {
                <ul class="crew-list">
                    @foreach (var j in Model.RecentJobs)
                    {
                        <li>
                            <a class="crew-name" href="@JobTreadIds.JobUrl(j.JobId)" target="_blank" rel="noopener">@j.JobName</a>
                            <span class="crew-meta num">@Format.Number(j.Hours) hrs · last @Format.Date(j.LastDay)</span>
                        </li>
                    }
                </ul>
                <p class="muted small num">@Format.Number(Model.RecentJobs.Sum(j => j.Hours)) hrs total on @Model.RecentJobs.Count @(Model.RecentJobs.Count == 1 ? "job" : "jobs")</p>
            }
            @if (Model.Bonus is { } bl)
            {
                var name = m.Staff.Name;
                var sm = Model.StatusMonth;
                var status = bl.Status(name, sm);
                var why = bl.Eligibility.Why(name, sm);
                var years = bl.Months.Select(x => x.Year).Distinct().OrderByDescending(x => x).ToList();
                <h3 class="detail-title">Bonuses</h3>
                <div class="job-chips">
                    @if (why is not null) { <span class="chip warn">@why</span> }
                    else if (!bl.Eligibility.HireDateKnown(name) && bl.Eligibility.HasQuickBooks) { <span class="chip">Hire date unknown</span> }
                    @if (status.ToMakeUp > 0) { <span class="chip warn">@Format.Money(status.ToMakeUp) to make up</span> }
                    @if (m.Staff.IsField && why is null && bl.FieldStaff.Any(s => s.MembershipId == m.Staff.MembershipId) && bl.EffortFor(m.Staff, sm).Ratings.Count == 0) { <span class="chip warn">Not rated for @BonusService.Label(sm)</span> }
                    @if (bl.LockFor(name, sm) is not null) { <span class="chip good">🔒 @BonusService.Label(sm) paid &amp; locked</span> }
                    <span class="chip">Owed now @Format.Money(status.Owed)</span>
                </div>
                @foreach (var y in years)
                {
                    var rows = bl.Year(name, y);
                    <details class="ledger-ytd" open="@(y == years[0])">
                        <summary class="link-button">@y@(rows.FirstOrDefault()?.Opening is { } op && op != 0 ? (op > 0 ? $" · year-end settlement {y - 1} +{Format.Money(op)}" : $" · carried from {y - 1} {Format.Money(op)}") : "")</summary>
                        <div class="table-wrap">
                            <table class="data compact">
                                <thead><tr><th>Month</th><th class="num">Earned</th><th class="num">Losses</th><th class="num">Net</th><th class="num">YTD net</th><th class="num">Held</th><th class="num">Paid</th><th class="num">Owed</th></tr></thead>
                                <tbody>
                                    @foreach (var row in rows)
                                    {
                                        var chk = Model.Checks.GetValueOrDefault(row.Month);
                                        <tr>
                                            <td>@BonusService.Label(row.Month)@(bl.LockFor(name, row.Month) is not null ? " 🔒" : "")</td>
                                            <td class="num">@Format.Money(row.Earned)</td>
                                            <td class="num@(row.Losses < 0 ? " neg" : "")">@Format.Money(row.Losses)</td>
                                            <td class="num">@Format.Money(row.Net)</td>
                                            <td class="num">@Format.Money(row.RunningNet)</td>
                                            <td class="num">@Format.Money(row.Held)</td>
                                            <td class="num">@Format.Money(row.Paid)@if (chk is not null) { <div class="muted small">check @string.Join(", ", chk.Select(c => "#" + c.Num))</div> }</td>
                                            <td class="num">@Format.Money(row.Owed)</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </details>
                }
                <p class="small"><a href="/financials/bonuses?month=@BonusService.Key(sm)&only=@Uri.EscapeDataString(name)">Full bonus reconcile for @m.Staff.FirstName ›</a></p>
            }
            <p class="muted small">
                JobTread role: @m.Staff.Role ·
                @(m.Staff.QboEmployeeId is null ? "no QuickBooks employee linked" : "linked to QuickBooks")
            </p>
        </div>
    </div>
}
